    { "resourceId": "res_voa_lle1_l4_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-4-what-is-it.mp3", "questions": [{"id":"l4-q1","stem":"What does Pete first say Anna has found instead of a pen?","options":["A book","A toy","A pillow","A lamp"]},{"id":"l4-q2","stem":"What does Marsha think one object might be?","options":["A toy","A cup","A hat","A key"]},{"id":"l4-q3","stem":"What does Pete identify after the toy guess?","options":["A pillow","A phone","A shoe","A map"]},{"id":"l4-q4","stem":"What is Anna's map of?","options":["The world","Washington","Her neighborhood","The United States"]},{"id":"l4-q5","stem":"What do Anna and her friends decide to do?","options":["Get coffee","Go to the gym","Visit the library","Go home"]}]},
    { "resourceId": "res_voa_lle1_l5_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-5-where-are-you.mp3", "questions": [{"id":"l5-q1","stem":"Where is Anna when she first arrives?","options":["In the kitchen","In the garden","In the bedroom","At the bus stop"]},{"id":"l5-q2","stem":"What do Marsha and Anna say people do in the kitchen?","options":["Cook and eat","Sleep and read","Wash and relax","Play and study"]},{"id":"l5-q3","stem":"Where do they relax?","options":["In the living room","In the bathroom","In the kitchen","In the garage"]},{"id":"l5-q4","stem":"Where does Anna say she washes?","options":["In the bathroom","In the bedroom","In the living room","In the kitchen"]},{"id":"l5-q5","stem":"Where do Marsha and Anna say they sleep?","options":["In the bedroom","In the kitchen","In the living room","In the bathroom"]}]},
    { "resourceId": "res_voa_lle1_l6_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-6-where-is-the-gym.mp3", "questions": [{"id":"l6-q1","stem":"Why does Anna ask Pete about the gym?","options":["She wants to work out","She wants to mail a letter","She wants to eat lunch","She wants to go home"]},{"id":"l6-q2","stem":"What place is next to the gym?","options":["The mailroom","The rooftop","The garage","The bedroom"]},{"id":"l6-q3","stem":"Which place does Anna visit but discover is not the gym?","options":["The parking garage","The library","The kitchen","The classroom"]},{"id":"l6-q4","stem":"Where is the gym in relation to the lobby?","options":["Behind it","Inside it","Across the street from it","Above it"]},{"id":"l6-q5","stem":"What does Pete invite Anna to do at the end?","options":["Work out with him","Go to the mailroom","Visit the rooftop","Record a show"]}]},
    { "resourceId": "res_voa_lle1_l7_listening_formal_v1", "contentVersion": 1, "audioFile": "lesson-7-what-are-you-doing.mp3", "questions": [{"id":"l7-q1","stem":"What is Anne doing when Anna first meets her?","options":["Writing","Cooking","Sleeping","Driving"]},{"id":"l7-q2","stem":"What is Jonathan doing in the studio?","options":["Recording his show","Reading a book","Making lunch","Cleaning the room"]},{"id":"l7-q3","stem":"What is Amelia reading for?","options":["Her show","A school test","A bus map","A recipe"]},{"id":"l7-q4","stem":"Where does Caty ask Anna to go so they can talk?","options":["Caty's office","The rooftop","The mailroom","The gym"]},{"id":"l7-q5","stem":"How does Anna feel the day is going?","options":["It is not going well","It is perfect","It is very quiet","It is almost over"]}]},
    { "resourceId": "res_voa_lle1_l8_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-8-are-you-busy.mp3", "questions": [{"id":"l8-q1","stem":"What is Anne doing at 10 a.m.?","options":["Writing","Driving","Cooking","Reading outside"]},{"id":"l8-q2","stem":"What does Jonathan do when the studio light is on?","options":["Records his evening show","Writes the morning show","Leaves the building","Meets Amelia"]},{"id":"l8-q3","stem":"When does Amelia invite Anna to come by?","options":["This afternoon","At 10 a.m.","At 5 p.m.","Tomorrow morning"]},{"id":"l8-q4","stem":"What time does Caty tell Anna to come to her office?","options":["5:00 p.m.","10:00 a.m.","12:00 noon","6:00 p.m."]},{"id":"l8-q5","stem":"What surprise do Anna's co-workers have for her?","options":["A party","A new studio","A day off","A new apartment"]}]},
    { "resourceId": "res_voa_lle1_l9_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-9-is-it-cold.mp3", "questions": [{"id":"l9-q1","stem":"What number does the phone give for the temperature?","options":["18 degrees","65 degrees","80 degrees","10 degrees"]},{"id":"l9-q2","stem":"What does Anna first think about 18 degrees?","options":["It is cold","It is very hot","It is snowy","It is windy"]},{"id":"l9-q3","stem":"What is 18 degrees Celsius in Fahrenheit in this conversation?","options":["65 degrees","18 degrees","32 degrees","80 degrees"]},{"id":"l9-q4","stem":"Which city's forecast was the phone giving at the end?","options":["Mexico City","Washington, D.C.","New York","London"]},{"id":"l9-q5","stem":"What should Anna remember to check?","options":["The right city's forecast","The time of the sunrise","The bus schedule","The temperature in her apartment"]}]},
    { "resourceId": "res_voa_lle1_l10_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-10-come-over.mp3", "questions": [{"id":"l10-q1","stem":"Who is coming to Anna's apartment?","options":["Ashley","Marsha","Amelia","Caty"]},{"id":"l10-q2","stem":"What is Anna's apartment near?","options":["The Columbia Heights Metro","A school","A hospital","A park"]},{"id":"l10-q3","stem":"After leaving the Metro, which way should Ashley turn first?","options":["Right","Left","Back","Toward the river"]},{"id":"l10-q4","stem":"What landmark is across from Anna's apartment?","options":["A big department store","A bus station","A library","A post office"]},{"id":"l10-q5","stem":"Why does Ashley ask Anna to name a coffee shop?","options":["There are three coffee shops","The Metro is closed","She cannot find the bus station","She has no map"]}]},
    { "resourceId": "res_voa_lle1_l11_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-11-neighborhood.mp3", "questions": [{"id":"l11-q1","stem":"What does Anna need to return to the library?","options":["Three books","Four letters","Some stamps","A coffee cup"]},{"id":"l11-q2","stem":"What does Anna discover inside the books?","options":["Letters","A map","Cash","A photo"]},{"id":"l11-q3","stem":"Where is the mailbox?","options":["Across from the store","Behind the library","Inside the bank","At the corner"]},{"id":"l11-q4","stem":"Where is the bank in relation to Anna?","options":["Behind her","Across from her","Next to the library","Far from the store"]},{"id":"l11-q5","stem":"What do Anna and Marsha plan to get after the errands?","options":["Ice cream","Coffee","Books","Stamps"]}]},
    { "resourceId": "res_voa_lle1_l12_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-12-meet-my-family.mp3", "questions": [{"id":"l12-q1","stem":"Why does Anna show Marsha her family photos?","options":["She feels homesick","She wants to sell them","She is planning a trip","She needs a new job"]},{"id":"l12-q2","stem":"What do Anna's parents do?","options":["They are rodeo clowns","They raise sheep","They make guitars","They teach music"]},{"id":"l12-q3","stem":"What does Aunt Lavender enjoy?","options":["Gardening","Driving","Singing","Painting"]},{"id":"l12-q4","stem":"Which two things does Uncle John do?","options":["Raises chickens and makes guitars","Raises horses and makes spoons","Makes sweaters and tells jokes","Grows vegetables and teaches music"]},{"id":"l12-q5","stem":"What do Anna's cousins do?","options":["They raise sheep and make sweaters","They make spoons and guitars","They perform at a rodeo","They grow flowers"]}]},
    { "resourceId": "res_voa_lle1_l13_listening_formal_v1", "contentVersion": 2, "audioFile": "lesson-13-shakespeare-birthday.mp3", "questions": [{"id":"l13-q1","stem":"Whose birthday is the party celebrating?","options":["William Shakespeare's","Anna's","Rebecca's","The Queen's"]},{"id":"l13-q2","stem":"What music performance does Anna hear?","options":["A drum band","A piano solo","A choir","A guitar lesson"]},{"id":"l13-q3","stem":"What kind of show does Anna watch?","options":["A puppet show","A weather show","A cooking show","A sports show"]},{"id":"l13-q4","stem":"Whom does Anna call very unusual to see in Washington, D.C.?","options":["The Queen of England","The President","A drum band","A writer"]},{"id":"l13-q5","stem":"Why does Anna say she is no longer bored?","options":["She is enjoying unusual birthday activities","She has finished shopping","She has gone home","She has found a new job"]}]}
