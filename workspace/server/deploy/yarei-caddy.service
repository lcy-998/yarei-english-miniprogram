[Unit]
Description=Yarei HTTPS reverse proxy
After=network-online.target yarei.service
Wants=network-online.target

[Service]
Type=notify
User=yarei-caddy
Group=yarei-caddy
Environment=XDG_DATA_HOME=/var/lib/yarei-caddy
Environment=XDG_CONFIG_HOME=/var/lib/yarei-caddy/config
ExecStart=/usr/local/bin/caddy run --config /opt/yarei/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /opt/yarei/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yarei-caddy
UMask=0077

[Install]
WantedBy=multi-user.target
