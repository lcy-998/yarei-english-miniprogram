      <view class="pronunciation-page pronunciation-inline">
    <state-panel wx:if="{{error}}" state="error" message="{{error}}"></state-panel>
    <view wx:elif="{{teacherReadonly}}" class="pronunciation-content">
      <view class="m1-card pronunciation-reference">
        <text class="pronunciation-heading">跟读原文</text>
        <text class="pronunciation-text">{{referenceText}}</text>
      </view>
      <view class="m1-card pronunciation-recording">
        <text class="pronunciation-heading">学生跟读</text>
        <text wx:if="{{teacherEvidenceState === 'loading'}}" class="pronunciation-duration">正在读取本次提交的跟读记录…</text>
        <text wx:elif="{{teacherEvidenceState === 'not_found'}}" class="pronunciation-duration">本次提交暂无此句段的有效跟读记录</text>
        <text wx:elif="{{teacherEvidenceState === 'error'}}" class="pronunciation-error">{{teacherEvidenceMessage || '跟读记录暂不可用'}}</text>
        <block wx:elif="{{teacherEvidenceState === 'ready' && teacherEvidence}}">
          <text class="pronunciation-duration">录音时长 {{teacherEvidence.durationMs || '未知'}}{{teacherEvidence.durationMs ? ' 毫秒' : ''}}</text>
          <text class="pronunciation-status">{{teacherEvidenceStatusLabel}}</text>
          <view wx:if="{{teacherEvidence.score}}" class="pronunciation-scores">
            <view class="pronunciation-total"><text>总分（试验）</text><text>{{teacherEvidence.score.total}}</text></view>
            <view><text>发音</text><text>{{teacherEvidence.score.pronunciation}}</text></view>
            <view><text>流利度</text><text>{{teacherEvidence.score.fluency}}</text></view>
            <view><text>完整度</text><text>{{teacherEvidence.score.completeness}}</text></view>
          </view>
          <view wx:if="{{teacherEvidence.bestScore}}" class="pronunciation-scores">
            <view class="pronunciation-total"><text>最佳试验分</text><text>{{teacherEvidence.bestScore.total}}</text></view>
            <view><text>最佳发音</text><text>{{teacherEvidence.bestScore.pronunciation}}</text></view>
            <view><text>最佳流利度</text><text>{{teacherEvidence.bestScore.fluency}}</text></view>
            <view><text>最佳完整度</text><text>{{teacherEvidence.bestScore.completeness}}</text></view>
          </view>
          <text wx:if="{{teacherEvidenceMessage}}" class="pronunciation-muted">{{teacherEvidenceMessage}}</text>
          <text wx:if="{{!teacherEvidence.playback && teacherEvidence.mediaExpired}}" class="pronunciation-muted">录音已过保留期限，评分状态仍可查看。</text>
          <text wx:elif="{{!teacherEvidence.playback}}" class="pronunciation-muted">此条跟读记录当前无法试听。</text>
        </block>
        <text wx:if="{{teacherPlaybackError}}" class="pronunciation-error">{{teacherPlaybackError}}</text>
        <view class="pronunciation-actions">
          <button wx:if="{{teacherEvidenceState === 'ready' && teacherEvidence.playback}}" class="pronunciation-secondary" bindtap="toggleTeacherEvidencePlayback">{{teacherEvidencePlaying ? '暂停试听' : '试听学生录音'}}</button>
          <button class="pronunciation-secondary" disabled="{{teacherEvidenceState === 'loading'}}" bindtap="refreshTeacherEvidence">刷新跟读情况</button>
        </view>
        <text class="pronunciation-muted">跟读试验分仅供练习参考，不计入正式任务成绩。</text>
      </view>
    </view>
    <view wx:else class="pronunciation-content">
      <view class="m1-card pronunciation-reference">
        <text class="pronunciation-heading">跟读原文</text>
        <view wx:if="{{referencePreview}}" class="pronunciation-subtitle" bindtap="toggleReferenceLanguage" aria-role="button" aria-label="切换中英文字幕">
          <text class="pronunciation-text">{{subtitleInChinese ? (translationText || '中文译文暂未提供') : referencePreview}}</text>
          
        </view>
        <text wx:else class="pronunciation-muted">录制前将从已授权内容读取本句原文。</text>
        <view wx:if="{{demonstrationUrl}}" class="pronunciation-actions"><button class="pronunciation-secondary" bindtap="playDemonstration">{{demonstrationPlaying ? '暂停示范' : '播放示范'}}</button><button class="pronunciation-secondary" bindtap="cycleDemonstrationSpeed">{{demonstrationSpeed}}×</button></view>
        <view wx:if="{{demonstrationError}}" class="pronunciation-actions"><text class="pronunciation-muted">{{demonstrationError}}</text><button class="pronunciation-secondary" bindtap="retryDemonstration">重试示范音频</button></view>
      </view>
      <view class="m1-card pronunciation-recording">
        <text class="pronunciation-heading">我的跟读</text>
        <text class="pronunciation-duration">{{recordingState === 'recording' ? '录音中 ' : busy && recordingState === 'local' ? '正在提交录音 ' : localPath ? '已录制 ' : '尚未录制'}}{{recordingState === 'recording' || localPath ? durationLabel : ''}}</text>
        <view class="pronunciation-actions">
          <button wx:if="{{recordingState === 'idle'}}" class="pronunciation-primary" disabled="{{busy}}" bindtap="startRecording">{{busy ? '正在准备…' : '开始录音'}}</button>
          <button wx:elif="{{recordingState === 'recording'}}" class="pronunciation-stop" bindtap="stopRecording">结束录音</button>
          <block wx:else>
            <button wx:if="{{localPath}}" class="pronunciation-secondary" disabled="{{busy}}" bindtap="playLocal">试听</button>
            <button class="pronunciation-secondary" disabled="{{busy}}" bindtap="redoRecording">重录</button>
          </block>
        </view>
        <text wx:if="{{recordingError}}" class="pronunciation-error">{{recordingError}}</text>
        <button wx:if="{{permissionDenied}}" class="pronunciation-secondary" bindtap="openMicrophoneSettings">打开麦克风设置</button>
        <text class="pronunciation-muted">录音需在 1 秒至 5 分钟之间，文件不超过 20 MB。上传失败会保留本机录音。</text>
        <text wx:if="{{scoreStatusLabel}}" class="pronunciation-status">{{scoreStatusLabel}}</text>
        <text wx:if="{{scoreMessage}}" class="pronunciation-muted">{{scoreMessage}}</text>
        <view wx:if="{{showScore && scoreView.score}}" class="pronunciation-scores">
          <view class="pronunciation-total"><text>总分</text><text>{{scoreView.score.total}}</text></view>
          <view><text>发音</text><text>{{scoreView.score.pronunciation}}</text></view>
          <view><text>流利度</text><text>{{scoreView.score.fluency}}</text></view>
          <view><text>完整度</text><text>{{scoreView.score.completeness}}</text></view>
        </view>
        <text wx:if="{{showScore}}" class="pronunciation-muted">试验结果仅供参考，不计正式成绩。</text>
        <text wx:if="{{source.kind === 'task' && effectiveAttemptNumber > 0}}" class="pronunciation-muted">本次为第 {{effectiveAttemptNumber}} / 5 次有效评分</text>
        <text wx:if="{{scoreError}}" class="pronunciation-error">{{scoreError}}</text>
        <button wx:if="{{localPath && !sealed && recordingError && durationMs >= 1000 && durationMs <= 300000 && sizeBytes > 0 && sizeBytes <= 20971520}}" class="pronunciation-secondary" disabled="{{busy}}" bindtap="uploadAndScore">重试提交录音</button>
        <button wx:if="{{sealed && !scoreId && !busy}}" class="pronunciation-secondary" bindtap="uploadAndScore">重试请求评分</button>
        <button wx:if="{{scoreId && scoreView.status === 'processing'}}" class="pronunciation-secondary" bindtap="manualRefreshScore">刷新评分结果</button>
        <button wx:if="{{sealed && (scoreView.status === 'failed' || scoreView.status === 'sealed' || scoreError)}}" class="pronunciation-secondary" disabled="{{busy}}" bindtap="retryScore">{{source.kind === 'reading' && scoreView.status === 'failed' && !scoreView.retryable ? '重新录制并评分' : '重新请求评分'}}</button>
      </view>
      <view wx:if="{{source.kind === 'task' && (attemptRows.length || historyError)}}" class="m1-card pronunciation-history">
        <text class="pronunciation-heading">历史尝试</text>
        <text wx:if="{{historyError}}" class="pronunciation-muted">历史记录暂不可用：{{historyError}}</text>
        <view wx:for="{{attemptRows}}" wx:key="scoreId" class="pronunciation-history-row"><view><text>{{item.label}}</text><text>{{item.timeLabel}}</text></view><text>{{item.scoreLabel}}</text><button wx:if="{{item.status === 'processing'}}" data-id="{{item.scoreId}}" bindtap="recoverProcessingScore">继续查看</button></view>
      </view>
    </view>
  </view>
