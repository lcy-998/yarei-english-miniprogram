<g0-page-shell nature="{{true}}" tone="nature"><view class="dubbing-page">
  <app-header title="视频配音" back="{{true}}"></app-header>
  <state-panel wx:if="{{loading}}" state="loading"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadMaterials"></state-panel>
  <view wx:else class="dubbing-content">
    <view class="dubbing-hero"><text class="dubbing-title">给故事配上你的声音</text><text class="dubbing-subtitle">选择素材、录制并试听，满意后再提交作品。</text></view>
    <view wx:if="{{!hasAuthorizedMaterials && !localPath}}" class="dubbing-card">暂无已授权的配音素材</view>
    <block wx:else>
      <view class="dubbing-card"><view class="material-heading"><view class="material-current"><text class="dubbing-section-title">当前素材</text><text class="material-current-title">{{selectedMaterial ? selectedMaterial.title : '尚未选择素材'}}</text><text wx:if="{{selectedMaterial && hasMaterialFilters}}" class="material-current-meta">{{selectedMaterial.grade || '未标注年级'}}　{{selectedMaterial.textbook || '未标注教材'}}　{{selectedMaterial.unit || '未标注单元'}}</text></view><button class="material-switch" bindtap="toggleMaterialSelect">{{materialSelectOpen ? '收起选择' : '选择素材'}}</button></view><text wx:if="{{!hasAuthorizedMaterials}}" class="dubbing-subtitle">当前没有可用素材，录音草稿仍保留在本次使用中。</text>
        <view wx:if="{{materialSelectOpen}}" class="material-selector"><input class="material-search" value="{{materialKeyword}}" bindinput="onMaterialSearch" maxlength="80" placeholder="搜索素材名称或字幕"/>
          <view wx:if="{{hasMaterialFilters}}" class="material-filter-row"><view class="material-filter"><button data-key="grade" bindtap="toggleMaterialFilter">{{gradeFilter}} ▾</button><view wx:if="{{materialFilterOpen === 'grade'}}" class="material-filter-menu"><view data-key="grade" data-value="全部年级" bindtap="chooseMaterialFilter">全部年级</view><view wx:for="{{materialFilterOptions.grades}}" wx:key="*this" data-key="grade" data-value="{{item}}" bindtap="chooseMaterialFilter">{{item}}</view></view></view><view class="material-filter"><button data-key="textbook" bindtap="toggleMaterialFilter">{{textbookFilter}} ▾</button><view wx:if="{{materialFilterOpen === 'textbook'}}" class="material-filter-menu"><view data-key="textbook" data-value="全部教材" bindtap="chooseMaterialFilter">全部教材</view><view wx:for="{{materialFilterOptions.textbooks}}" wx:key="*this" data-key="textbook" data-value="{{item}}" bindtap="chooseMaterialFilter">{{item}}</view></view></view><view class="material-filter"><button data-key="unit" bindtap="toggleMaterialFilter">{{unitFilter}} ▾</button><view wx:if="{{materialFilterOpen === 'unit'}}" class="material-filter-menu"><view data-key="unit" data-value="全部单元" bindtap="chooseMaterialFilter">全部单元</view><view wx:for="{{materialFilterOptions.units}}" wx:key="*this" data-key="unit" data-value="{{item}}" bindtap="chooseMaterialFilter">{{item}}</view></view></view></view>
          <view class="material-results-head"><text>找到 {{materialTotal}} 个素材</text><button bindtap="clearMaterialSearch">清除筛选</button></view><scroll-view scroll-y="{{true}}" class="material-options" style="height: {{materials.length > 3 ? 280 : materials.length * 88 + 62}}px"><button wx:for="{{materials}}" wx:key="id" class="material-option {{selectedMaterialId === item.id && selectedMaterial ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectMaterial"><text class="material-option-title">{{item.title}}</text><text wx:if="{{hasMaterialFilters}}" class="material-option-meta">{{item.grade || '未标注年级'}}　{{item.textbook || '未标注教材'}}　{{item.unit || '未标注单元'}}</text><text class="material-option-subtitle">{{item.subtitle}}</text></button><text wx:if="{{!materials.length && !materialSearchLoading}}" class="material-empty">当前条件下暂无素材，可调整筛选。</text><text wx:if="{{materialSearchError}}" class="material-empty">{{materialSearchError}}</text><button wx:if="{{materialNextOffset !== null}}" class="material-more" bindtap="loadMoreMaterials" loading="{{materialSearchLoading}}">加载更多</button></scroll-view></view>
      </view>
      <view wx:if="{{selectedMaterial}}" class="dubbing-card"><view class="dubbing-section-row"><text class="dubbing-section-title">示范素材</text><button class="speed-button" bindtap="cycleSpeed">{{demonstrationSpeed}} 倍速</button></view>
        <video wx:if="{{demonstrationUrl}}" id="demonstration" class="demonstration-video" src="{{demonstrationUrl}}" controls="{{true}}" autoplay="{{false}}" show-center-play-btn="{{true}}"></video>
        <view wx:else class="material-unavailable">示范视频暂不可播放，请稍后重试</view>
        <text class="subtitle-text">{{selectedMaterial.subtitle}}</text>
      </view>
      <view class="dubbing-card"><text class="dubbing-section-title">录制配音</text>
        <view class="recording-status {{recordingState === 'recording' ? 'is-recording' : recordingIssue ? 'is-invalid' : ''}}"><text>{{recordingState === 'recording' ? '正在录音' : recordingState === 'uploading' ? '正在上传并核验' : recordingState === 'submitted' ? '作品已提交' : recordingIssue ? '录音不可提交' : localPath ? '录音已保留在本机' : '等待录音'}}</text><text>{{durationLabel}}</text></view>
        <text wx:if="{{recordingIssue}}" class="recording-issue">{{recordingIssue}}</text>
        <view class="record-actions"><button wx:if="{{recordingState === 'recording'}}" class="recording-active" bindtap="stopRecording">结束录音</button><button wx:elif="{{!localPath}}" disabled="{{!selectedMaterial}}" bindtap="startRecording">开始录音</button><button wx:elif="{{!recordingIssue}}" bindtap="playRecording">试听录音</button><button wx:if="{{localPath && !submitting}}" bindtap="redoRecording">重录</button></view>
        <textarea class="work-note" maxlength="200" value="{{note}}" bindinput="onNote" placeholder="给作品写一句话（选填）"></textarea>
        <view wx:if="{{submitError}}" class="submit-retry"><image src="/assets/g0/recording-ai-retry-thumb-v1.png" mode="aspectFit" aria-hidden="true"></image><text class="submit-error">{{submitError}}</text></view>
        <button class="submit-work" disabled="{{!localPath || !selectedMaterial || !!recordingIssue || submitting || recordingState === 'submitted'}}" loading="{{submitting}}" bindtap="submitRecording">提交作品</button>
      </view>
    </block>
    <button class="my-works-link" bindtap="openMyWorks">查看我的作品 ›</button>
  </view>
</view></g0-page-shell>
