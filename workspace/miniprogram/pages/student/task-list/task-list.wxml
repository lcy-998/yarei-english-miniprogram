<view class="page">
  <image class="page-bg" src="/assets/visual-v2/nature-background-vivid-v2.jpg" mode="scaleToFill" aria-hidden="true"></image>
  <app-header title="我的任务" back="{{true}}"></app-header>
  <state-panel wx:if="{{loading}}" state="loading"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadTasks"></state-panel>
  <view wx:else class="content">
    <view class="summary-card"><image src="/assets/visual-v2/task-generic.png" mode="aspectFit"></image><view><text class="summary-title">学习任务</text><text class="summary-note">按进度查看并继续今天的任务</text></view><view class="summary-count"><text>{{allTasks.length}}</text><text>全部</text></view></view>
    <view class="filters"><view class="filter {{currentFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setFilter">全部 {{allTasks.length}}</view><view class="filter {{currentFilter === 'active' ? 'active' : ''}}" data-filter="active" bindtap="setFilter">进行中 {{activeCount}}</view><view class="filter {{currentFilter === 'completed' ? 'active' : ''}}" data-filter="completed" bindtap="setFilter">已完成 {{completedCount}}</view></view>
    <view class="list"><view wx:for="{{tasks}}" wx:key="task.id" class="task" data-id="{{item.task.id}}" bindtap="openTask"><view class="status-mark {{item.assignment.status === 'completed' ? 'completed' : ''}}"></view><view class="task-copy"><text class="title">{{item.task.title}}</text><text class="meta">{{item.assignment.status === 'awaiting_review' ? '待检查' : item.assignment.status === 'completed' ? '已完成' : '进行中'}} · 今天 20:00</text></view><view class="arrow" aria-hidden="true"></view></view><view wx:if="{{!tasks.length}}" class="empty">当前筛选下暂无任务</view></view>
  </view>
</view>
