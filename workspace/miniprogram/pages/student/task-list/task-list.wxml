<view class="page page--secondary">
  <image class="page-bg" src="/assets/g0/student-public-natural-background-v1.jpg" mode="scaleToFill" aria-hidden="true"></image>
  <app-header title="我的任务" back="{{true}}" backUrl="/pages/index/index"></app-header>
  <state-panel wx:if="{{loading}}" state="loading"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadTasks"></state-panel>
  <view wx:else class="content">
    <view class="summary-card"><g0-icon name="task" size="58"></g0-icon><view><text class="summary-title">学习任务</text><text class="summary-note">按进度查看并继续今天的任务</text></view><view class="summary-count"><text>{{allTasks.length + allActivities.length}}</text><text>全部</text></view></view>
    <view class="range-row"><view aria-label="任务时间范围"><button class="{{timeRange === '30' ? 'selected' : ''}}" data-range="30" bindtap="setTimeRange">近30天</button><button class="{{timeRange === '90' ? 'selected' : ''}}" data-range="90" bindtap="setTimeRange">近90天</button><button class="{{timeRange === 'all' ? 'selected' : ''}}" data-range="all" bindtap="setTimeRange">全部</button></view></view>
    <scroll-view class="filters-scroll" scroll-x="{{true}}"><view class="filters"><view class="filter {{currentFilter === 'pending' ? 'active' : ''}}" data-filter="pending" bindtap="setFilter">待处理 {{pendingCount}}</view><view class="filter {{currentFilter === 'review' ? 'active' : ''}}" data-filter="review" bindtap="setFilter">待检查 {{reviewCount}}</view><view class="filter {{currentFilter === 'completed' ? 'active' : ''}}" data-filter="completed" bindtap="setFilter">已完成 {{completedCount}}</view><view class="filter {{currentFilter === 'overdue_redo' ? 'active' : ''}}" data-filter="overdue_redo" bindtap="setFilter">逾期/重做 {{overdueRedoCount}}</view><view class="filter {{currentFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setFilter">全部 {{totalVisibleCount}}</view></view></scroll-view>
    <view class="list"><view wx:for="{{tasks}}" wx:key="key" class="task" data-id="{{item.task.id}}" bindtap="openTask"><view class="status-mark {{item.assignment.status === 'completed' ? 'completed' : ''}}"></view><view class="task-copy"><text class="title">{{item.task.title}}</text><text class="meta">{{item.statusLabel}}　{{item.dueLabel}} 截止</text></view><view class="arrow" aria-hidden="true"></view></view><view wx:for="{{activities}}" wx:key="key" class="task" data-id="{{item.activity.id}}" bindtap="openActivity"><view class="status-mark {{item.filter === 'completed' ? 'completed' : ''}}"></view><view class="task-copy"><text class="title">{{item.activity.title}}</text><text class="meta">打卡活动 · {{item.statusLabel}}　{{item.dueLabel}} 结束</text></view><view class="arrow" aria-hidden="true"></view></view><view wx:if="{{!tasks.length && !activities.length}}" class="empty">当前筛选下暂无任务</view></view>
  </view>
</view>
