<g0-page-shell nature="{{true}}" tone="nature"><view class="m1-page reading-detail"><app-header title="阅读详情" back="{{true}}" backUrl="/pages/student/reading-library/reading-library"></app-header><state-panel wx:if="{{loading}}" state="loading"></state-panel><state-panel wx:elif="{{error && !reading}}" state="error" message="{{error}}" bind:retry="loadReading"></state-panel><view wx:elif="{{reading}}" class="m1-content"><view class="m1-card detail-head"><view><text class="book-name">{{reading.book.title}}</text><text class="page-meta">第 {{reading.chapterNumber}} 章 · {{reading.pageNumber}} / {{reading.pageCount}}</text></view><button class="detail-favorite {{reading.book.favorite ? 'active' : ''}}" bindtap="toggleFavorite">{{reading.book.favorite ? '已收藏' : '收藏'}}</button></view><view class="m1-card progress-card"><view><text>阅读进度</text><text>{{reading.progressPercent}}%</text></view><view class="m1-progress"><view style="width: {{reading.progressPercent}}%"></view></view></view><view class="page-frame" bindtap="previewPage"><view wx:if="{{imageLoading}}" class="page-loading">高清页图加载中…</view><view wx:if="{{imageError}}" class="page-error"><text>高清页图加载失败</text><text>保留页图位置，不用抽取正文替代</text><button bindtap="retryImage">重试</button></view><image class="reading-page-image" src="{{reading.pageImageUrl}}" mode="widthFix" bindload="imageLoaded" binderror="imageFailed" aria-label="虚构绘本 A Day at the Zoo 第 {{reading.pageNumber}} 页页图"></image><view class="zoom-hint">点击页图放大</view></view><view class="page-actions"><view class="page-action"><g0-button variant="secondary" disabled="{{reading.pageNumber <= 1 || saving}}" bind:action="previousPage">上一页</g0-button></view><view class="page-action"><g0-button disabled="{{reading.pageNumber >= reading.pageCount || saving}}" loading="{{saving}}" bind:action="nextPage">下一页</g0-button></view></view><text class="autosave">已自动保存阅读位置</text></view></view></g0-page-shell>

