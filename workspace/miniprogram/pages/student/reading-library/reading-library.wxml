<g0-page-shell nature="{{true}}" tone="nature">
  <view class="m1-page reading-library" bindtap="closeFilter">
    <app-header title=""></app-header>
    <view class="reading-hero"><view class="brand-line"><image src="/assets/g0/brand-logo.png" mode="aspectFit"></image><text>雅睿英语</text></view><view class="hero-title"><text>阅读专区</text><image src="/assets/g0/mascot-learning-blue.png" mode="widthFix"></image></view><view class="search-shell"><view class="search-symbol"></view><input value="{{keyword}}" placeholder="搜索书名" bindinput="onSearch"/></view></view>
    <view class="category-panel"><view wx:for="{{categories}}" wx:key="key" class="category {{category === item.key ? 'active' : ''}}" data-category="{{item.key}}" bindtap="setCategory"><view class="category-icon category-icon--{{item.key}}"><view></view></view><text>{{item.label}}</text></view></view>
    <view class="filter-row">
      <view class="filter-control"><button data-key="grade" bindtap="toggleFilter">{{gradeFilter}}<text class="filter-chevron {{filterOpen === 'grade' ? 'is-open' : ''}}"></text></button><view wx:if="{{filterOpen === 'grade'}}" class="filter-menu"><view wx:for="{{filterOptions.grade}}" wx:key="*this" class="filter-option {{gradeFilter === item ? 'selected' : ''}}" data-key="grade" data-value="{{item}}" bindtap="chooseFilter">{{item}}</view></view></view>
      <view class="filter-control"><button data-key="difficulty" bindtap="toggleFilter">{{difficultyFilter}}<text class="filter-chevron {{filterOpen === 'difficulty' ? 'is-open' : ''}}"></text></button><view wx:if="{{filterOpen === 'difficulty'}}" class="filter-menu"><view wx:for="{{filterOptions.difficulty}}" wx:key="*this" class="filter-option {{difficultyFilter === item ? 'selected' : ''}}" data-key="difficulty" data-value="{{item}}" bindtap="chooseFilter">{{item}}</view></view></view>
      <view class="filter-control"><button data-key="theme" bindtap="toggleFilter">{{themeFilter}}<text class="filter-chevron {{filterOpen === 'theme' ? 'is-open' : ''}}"></text></button><view wx:if="{{filterOpen === 'theme'}}" class="filter-menu"><view wx:for="{{filterOptions.theme}}" wx:key="*this" class="filter-option {{themeFilter === item ? 'selected' : ''}}" data-key="theme" data-value="{{item}}" bindtap="chooseFilter">{{item}}</view></view></view>
    </view>
    <view class="book-area"><state-panel wx:if="{{loading}}" state="loading"></state-panel><state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadBooks"></state-panel><view wx:else class="book-list"><view class="book-result-head"><text>{{favoritesOnly ? '已加载收藏' : '找到'}} {{favoritesOnly ? visibleBooks.length : resultTotal}} 本</text><button bindtap="clearFilters">清除筛选</button></view><view wx:for="{{visibleBooks}}" wx:key="id" class="book-card"><view class="book-cover" data-id="{{item.id}}" bindtap="openBook"><view class="cover-sun"></view><view class="cover-hills"></view><view class="cover-book"></view></view><view class="book-copy" data-id="{{item.id}}" bindtap="openBook"><text class="book-title">{{item.title}}</text><text class="book-meta">{{item.grade}}　{{item.difficulty}}</text><text wx:if="{{item.category === 'textbook'}}" class="book-meta">{{item.textbook || '未标注教材'}}{{item.unit ? '　' + item.unit : ''}}</text><view wx:if="{{item.progressPercent > 0}}" class="progress-row"><text>已读 <text>{{item.progressPercent}}%</text></text><view class="m1-progress"><view style="width: {{item.progressPercent}}%"></view></view></view><view wx:if="{{item.id === 'book_zoo'}}" class="ability-row"><text>音频</text><text>点读</text><text>跟读</text></view></view><button class="favorite {{item.favorite ? 'active' : ''}}" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}" data-id="{{item.id}}" bindtap="toggleFavorite"><view></view></button><button wx:if="{{item.progressPercent > 0}}" class="continue" data-id="{{item.id}}" bindtap="openBook">继续阅读 ›</button></view><view wx:if="{{!visibleBooks.length && nextOffset === null}}" class="m1-card m1-empty">当前筛选下暂无可用阅读内容，可切换其他筛选。</view><view wx:if="{{pageError}}" class="m1-card m1-empty">{{pageError}}<button bindtap="retryCatalog">重试</button></view><button wx:if="{{nextOffset !== null}}" bindtap="loadMoreBooks" loading="{{loadingMore}}">加载更多</button></view></view>
    <g0-tab-bar role="student" active="reading"></g0-tab-bar>
  </view>
</g0-page-shell>

