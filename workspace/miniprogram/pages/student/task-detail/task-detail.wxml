<view class="page page--secondary">
  <image class="page-bg" src="/assets/g0/student-public-natural-background-v1.jpg" mode="scaleToFill" aria-hidden="true"></image>
  <app-header title="任务详情" back="{{true}}"></app-header>
  <state-panel wx:if="{{loading}}" state="loading"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadDetail"></state-panel>
  <view wx:elif="{{teacherReviewMode && teacherReviewItem}}" class="content">
    <view class="hero-card"><view class="hero-copy"><text class="label">教师只读查看 · 第 {{teacherReviewVersion}} 次提交</text><text class="title">{{teacherReviewItem.title}}</text></view><view class="task-art"><g0-icon name="task" size="64"></g0-icon></view></view>
    <view class="section"><text class="section-title">{{teacherReviewItem.type === 'exercise' ? '习题作答' : '课堂录音'}}</text>
      <view wx:if="{{teacherReviewItem.type === 'exercise'}}" class="completion-item"><view wx:if="{{teacherExercise}}" class="exercise-question"><text class="exercise-stem">{{teacherExercise.stem}}</text><view wx:if="{{teacherExerciseChoices.length}}" class="exercise-choices"><button wx:for="{{teacherExerciseChoices}}" wx:key="id" class="exercise-choice {{item.selected ? 'selected' : ''}} {{item.selected && teacherExercise.isCorrect === false ? 'teacher-wrong' : ''}} {{item.selected && teacherExercise.isCorrect === true ? 'teacher-correct' : ''}}" disabled="{{true}}">{{item.value}}</button></view><textarea wx:else class="exercise-response" value="{{teacherAnswerLabel}}" disabled="{{true}}"></textarea><text class="submitted-answer">学生答案：{{teacherAnswerLabel}}</text><text class="completion-help">正确答案：{{teacherCorrectLabel}}</text><text class="teacher-review-verdict {{teacherExercise.isCorrect === true ? 'teacher-review-verdict--correct' : teacherExercise.isCorrect === false ? 'teacher-review-verdict--wrong' : ''}}">{{teacherVerdict}}</text><text class="completion-help">解析：{{teacherExercise.explanation}}</text></view><text wx:else class="completion-help">本次提交缺少逐题证据，无法还原原作答。</text></view>
      <view wx:else class="completion-item"><text class="completion-title">{{teacherReviewItem.title}}</text><text class="completion-help">{{teacherReviewItem.recordingPrompt || '按教师要求录制并提交'}}</text><text wx:if="{{teacherRecordingId}}" class="completion-help">录音时长 {{teacherRecordingDuration}}</text><view class="recording-controls"><button wx:if="{{teacherRecordingState === 'available'}}" bindtap="playTeacherRecording">试听学生录音</button><text wx:elif="{{teacherRecordingState === 'expired'}}">录音已过保留期；提交和评分记录仍保留。</text><text wx:elif="{{teacherRecordingState === 'error'}}">录音状态暂不可用，请稍后重试。</text><text wx:else>本次提交没有可试听录音。</text></view></view>
      <view wx:if="{{teacherManualScoreRequired}}" class="teacher-review-score"><text class="teacher-review-score-title">本项评分草稿</text><view class="teacher-review-score-control"><input type="number" maxlength="3" value="{{teacherScoreInput}}" bindinput="onTeacherReviewScore" placeholder="0—100"/><text>分</text></view><text wx:if="{{teacherScoreError}}" class="teacher-review-score-error">{{teacherScoreError}}</text><text class="completion-help">返回教师点评后核对加权总分；发布前仍可修改。</text></view>
    </view>
  </view>
  <view wx:elif="{{detail}}" class="content">
    <view class="hero-card">
      <view class="hero-copy"><text class="label">课堂任务</text><text class="title">{{detail.task.title}}</text><text class="due">截止时间：{{dueLabel}}</text></view>
      <view class="task-art"><g0-icon name="task" size="64"></g0-icon></view>
      <view class="progress" role="progressbar" aria-valuenow="{{progressPercent}}"><view style="width: {{progressPercent}}%;"></view></view>
      <view class="status-row"><view class="status-dot"></view><text class="status">{{statusLabel}} · {{completedCount}}/{{detail.task.items.length}} 项</text><text class="percent">{{progressPercent}}%</text></view>
    </view>
    <view wx:if="{{detail.assignment.status === 'redo_required' || (detail.assignment.status === 'in_progress' && detail.assignment.redoDueAt)}}" class="redo-banner"><text>{{redoExpired ? '重做期限已过' : '退回重做'}}</text><text wx:if="{{redoDueLabel}}">重做截止：{{redoDueLabel}}</text><text wx:else>重做期限不可用，请联系老师</text><text wx:if="{{!redoExpired}}">请重新完成任务要求；上一版作答不会自动沿用。</text></view>
    <view wx:if="{{writeTimingLabel && editable}}" class="availability-note">{{writeTimingLabel}}：请在可提交期限内完成并提交。</view>
    <view wx:if="{{!editable && writeUnavailableReason}}" class="availability-note">{{writeUnavailableReason}}</view>
    <view wx:if="{{detail.task.items.length > 1}}" class="section item-navigation"><view class="item-navigation-head"><text class="section-title">作业项目</text><text>已定位第 {{selectedItemIndex + 1}} / {{detail.task.items.length}} 项</text></view><scroll-view scroll-x class="item-navigation-list"><view class="item-navigation-chips"><view wx:for="{{requirementItems}}" wx:key="id" class="item-navigation-chip {{index === selectedItemIndex ? 'item-navigation-chip--active' : ''}}" data-index="{{index}}" bindtap="jumpToItem" aria-role="button">{{index + 1}}. {{item.title}} · {{item.progressLabel}}</view></view></scroll-view><button wx:if="{{editable}}" class="jump-incomplete" bindtap="jumpToFirstIncomplete">定位第一项未完成内容</button></view>
    <view class="section">
      <text class="section-title">任务要求</text>
      <text class="description">{{detail.task.description}}</text>
      <view wx:if="{{readingSyncError}}" class="reading-sync-error"><text>{{readingSyncError}}</text><button bindtap="refreshReadingCompletion">重试同步</button></view>
      <view wx:if="{{selectedReadingSyncError}}" class="reading-sync-error"><text>{{selectedReadingSyncError}}</text><button bindtap="refreshTaskReadingProof">重试同步</button></view>
      <view wx:if="{{vocabularySyncError}}" class="reading-sync-error"><text>{{vocabularySyncError}}</text><button bindtap="refreshVocabularyCompletion">重试同步</button></view>
      <view class="requirement-list"><view wx:for="{{requirementItems}}" wx:key="id" id="requirement-item-{{index}}" class="item"><view class="item-mark"></view><view class="item-copy"><text class="item-title">{{item.title}}</text><text class="item-rule">{{item.completionRule}}</text><text wx:if="{{item.readingPageRangeLabel}}" class="item-rule">指定页：{{item.readingPageRangeLabel}}</text><text class="item-status {{item.progressComplete ? 'item-status--complete' : ''}}">{{item.progressLabel}}</text><button wx:if="{{item.type === 'reading'}}" class="open-reading" data-id="{{item.id}}" bindtap="openReading">去阅读</button><button wx:elif="{{item.type === 'vocabulary'}}" class="open-reading" data-id="{{item.id}}" bindtap="openVocabulary">去练习</button></view></view></view>
    </view>
    <view wx:if="{{detail.feedback}}" class="feedback"><g0-icon name="review" tone="ai" size="54"></g0-icon><view><text class="section-title">{{detail.feedback.decision === 'returned' ? '退回重做' : '教师反馈'}}</text><text wx:if="{{feedbackVersion}}" class="completion-help">第 {{feedbackVersion}} 次提交的反馈</text><text wx:if="{{detail.feedback.score !== null && detail.feedback.score !== undefined}}" class="score">教师评分：{{detail.feedback.score}} 分</text><text wx:else class="completion-help">此历史反馈未记录分数</text><text wx:if="{{detail.feedback.returnReason}}" class="feedback-copy">重做原因：{{detail.feedback.returnReason}}</text><text wx:if="{{detail.feedback.textComment}}" class="feedback-copy">老师评语：{{detail.feedback.textComment}}</text></view></view>
    <view wx:if="{{!detail.feedback && detail.submission && detail.submission.status !== 'draft' && detail.automaticScore !== null && detail.automaticScore !== undefined}}" class="section"><text class="section-title">系统参考分</text><text class="score">{{detail.automaticScore}} 分</text><text>等待老师复核与发布正式反馈。</text></view>
    <view wx:if="{{historyEntries.length}}" class="section submission-history"><text class="section-title">提交记录</text><view wx:for="{{historyEntries}}" wx:key="version" class="history-row {{item.version === selectedHistoryVersion ? 'history-row--selected' : ''}}" data-version="{{item.version}}" bindtap="selectHistoryVersion" aria-role="button"><view><text>第 {{item.version}} 次提交　{{item.statusLabel}}</text><text class="completion-help">{{item.hasAnswers ? '点击查看该次作答' : '旧数据未保存逐项答案'}}</text></view><text>{{item.submittedLabel}}</text></view></view>
    <view wx:if="{{submittedAnswerRows.length}}" class="section submitted-answers"><text class="section-title">第 {{submissionAnswerVersion}} 次提交 · 我的作答（只读）</text><view wx:for="{{submittedAnswerRows}}" wx:key="itemId" class="completion-item"><text class="completion-title">{{item.title}}</text><text wx:if="{{item.question}}" class="exercise-stem">{{item.question}}</text><text class="submitted-answer">我的答案：{{item.answer}}</text><button wx:if="{{item.recordingId}}" class="open-reading" data-id="{{item.recordingId}}" bindtap="playHistoryRecording">试听这次录音</button><text wx:if="{{selectedHistoryFeedback && selectedHistoryFeedback.decision === 'approved' && item.result}}" class="completion-help">{{item.result}}</text></view><text wx:if="{{submittedLearningRecord}}" class="submitted-answer">学习记录：{{submittedLearningRecord}}</text><text wx:if="{{!selectedHistoryFeedback || selectedHistoryFeedback.decision !== 'approved'}}" class="completion-help">本版本尚无已发布的订正说明；请参考老师的退回原因，或询问具体改法。</text><text wx:else class="completion-help">本任务未提供可向学生展示的标准答案或解析；如需进一步订正，请询问老师。</text></view>
    <view wx:if="{{selectedHistoryFeedback && selectedHistoryVersion !== feedbackVersion}}" class="section"><text class="section-title">第 {{selectedHistoryVersion}} 次提交 · 老师反馈</text><text wx:if="{{selectedHistoryFeedback.score !== undefined}}" class="score">{{selectedHistoryFeedback.score}} 分</text><text wx:else class="completion-help">此历史反馈未记录分数</text><text wx:if="{{selectedHistoryFeedback.returnReason}}" class="feedback-copy">重做原因：{{selectedHistoryFeedback.returnReason}}</text><text wx:if="{{selectedHistoryFeedback.textComment}}" class="feedback-copy">老师评语：{{selectedHistoryFeedback.textComment}}</text></view>
    <view wx:if="{{!editable && hasRecordingTask}}" class="section"><text class="section-title">本次录音</text><view wx:for="{{completionInputs}}" wx:key="itemId"><view wx:if="{{item.type === 'recording'}}" class="completion-item"><text class="completion-title">{{item.title}}</text><text class="completion-help">{{item.recordingPrompt}}</text><text wx:if="{{item.recordingId}}" class="completion-help">录音时长 {{item.recordingElapsedLabel}}</text><button wx:if="{{item.recordingId && item.recordingMediaAvailable}}" class="open-reading" data-id="{{item.itemId}}" bindtap="playSubmittedRecording">试听已提交录音</button><text wx:elif="{{item.recordingMediaExpired}}" class="completion-help">录音已过保留期；提交和评分记录仍保留。</text><text wx:elif="{{item.recordingId}}" class="completion-help">录音状态暂不可用，请稍后重新打开任务。</text><text wx:else class="completion-help">当前版本没有可试听的录音</text></view></view><text wx:if="{{recordingError}}" class="completion-help">{{recordingError}}</text></view>
    <view wx:if="{{hasCompletionForm && editable}}" class="section completion-section">
      <text class="section-title">任务作答</text>
      <text wx:if="{{hasUnsupportedExercise}}" class="completion-help">本任务含尚未开放的习题内容，暂不能提交；已填写的学习记录可保留。</text>
      <view wx:if="{{recordingError}}" class="reading-sync-error"><text>{{recordingError}}</text></view>
      <block wx:for="{{completionInputs}}" wx:key="itemId"><view wx:if="{{item.type === 'recording' || item.type === 'exercise' || !item.resourceId}}" id="answer-item-{{index}}" class="completion-item">
        <text class="completion-title">{{item.title}}</text>
        <text class="completion-help">完成要求：{{item.type === 'recording' ? '提交有效录音，由老师评分' : item.type === 'reading' ? item.requiredCount + ' 页' : item.type === 'vocabulary' ? item.requiredCount + ' 词' : item.requiredCount + ' 题'}}</text>
        <text wx:if="{{item.type === 'reading' && item.pageIds}}" class="completion-help">请在阅读页完成教师指定的 {{item.pageIds.length}} 页{{item.pageRangeLabel}}。提交时会核对逐页记录。</text>
        <text wx:elif="{{item.type === 'reading' && item.resourceId}}" class="completion-help">{{item.readingVerified ? '阅读进度已同步' : '请先打开阅读并保存进度'}}</text>
        <view wx:if="{{item.type === 'reading' && !item.resourceId}}" class="completion-field"><text>完成页数</text><input type="number" value="{{item.completedPageCount}}" data-id="{{item.itemId}}" data-field="completedPageCount" bindinput="onCompletionInput" placeholder="请输入"/></view>
        <block wx:elif="{{item.type === 'vocabulary'}}"><text wx:if="{{item.resourceId}}" class="completion-help">{{item.vocabularyVerified ? '已同步单词练习记录' : '请先完成单词练习'}}</text><view class="completion-field"><text>完成词数</text><input type="number" value="{{item.completedWordCount}}" disabled="{{item.resourceId ? true : false}}" data-id="{{item.itemId}}" data-field="completedWordCount" bindinput="onCompletionInput" placeholder="练习后自动更新"/></view><view class="completion-field"><text>首次正确词数</text><input type="number" value="{{item.correctWordCount}}" disabled="{{item.resourceId ? true : false}}" data-id="{{item.itemId}}" data-field="correctWordCount" bindinput="onCompletionInput" placeholder="练习后自动更新"/></view></block>
        <block wx:elif="{{item.type === 'recording'}}"><text class="completion-help">{{item.recordingPrompt}}</text><text wx:if="{{item.recordingId}}" class="completion-help">录音已封存，可提交任务。</text><text wx:elif="{{item.recordingState === 'invalid'}}" class="completion-help">本次录音不可提交，请重新录制。</text><text wx:elif="{{item.localRecordingPath}}" class="completion-help">录音已保留在本机，试听后上传。</text><text wx:else class="completion-help">请按提示录制 1 秒至 5 分钟的录音。</text><view class="recording-controls"><button wx:if="{{item.recordingState === 'recording'}}" class="recording-active" bindtap="stopRecording">● 录音中 {{item.recordingElapsedLabel}} · 点击结束</button><button wx:elif="{{item.recordingState === 'idle'}}" data-id="{{item.itemId}}" bindtap="startRecording">开始录音</button><button wx:if="{{item.localRecordingPath && item.recordingState !== 'invalid'}}" data-id="{{item.itemId}}" bindtap="playLocalRecording">试听本机录音</button><button wx:if="{{item.recordingId}}" data-id="{{item.itemId}}" bindtap="playSubmittedRecording">试听已上传录音</button><button wx:if="{{item.recordingState === 'local'}}" data-id="{{item.itemId}}" bindtap="uploadRecording">上传录音</button><button wx:if="{{item.recordingState === 'local' || item.recordingState === 'invalid' || item.recordingState === 'submitted'}}" data-id="{{item.itemId}}" bindtap="redoRecording">重录</button><text wx:if="{{item.recordingState === 'uploading'}}">上传核验中…</text><text wx:if="{{item.recordingState === 'local' || item.recordingState === 'invalid' || item.recordingState === 'submitted'}}">录音时长 {{item.recordingElapsedLabel}}</text></view></block>
        <block wx:else><view wx:if="{{item.exerciseQuestion}}" class="exercise-question"><text class="exercise-stem">{{item.exerciseQuestion.stem}}</text><view wx:if="{{item.exerciseChoices.length}}" class="exercise-choices"><button wx:for="{{item.exerciseChoices}}" wx:for-item="choice" wx:key="value" class="exercise-choice {{choice.selected ? 'selected' : ''}}" data-id="{{item.itemId}}" data-value="{{choice.value}}" bindtap="chooseExerciseOption">{{choice.value}}</button></view><textarea wx:else class="exercise-response" value="{{item.exerciseResponse}}" data-id="{{item.itemId}}" bindinput="onExerciseResponse" placeholder="请输入本题答案" maxlength="500"></textarea></view><view wx:else class="completion-field"><text>{{item.resourceId ? '习题资源暂不可作答' : '已答题数'}}</text><input wx:if="{{!item.resourceId}}" type="number" value="{{item.answeredQuestionCount}}" data-id="{{item.itemId}}" data-field="answeredQuestionCount" bindinput="onCompletionInput" placeholder="请输入"/></view></block>
      </view></block>
    </view>
    <view wx:if="{{editable}}" class="section"><text class="section-title">学习记录（选填）</text><textarea value="{{answer}}" maxlength="200" placeholder="可以写下学习收获" bindinput="onAnswer"></textarea></view>
    <view wx:if="{{writeError}}" class="write-error">{{writeError}}</view>
    <view wx:if="{{editable}}" class="completion-help">保存草稿会保留已填写的项目和学习记录；未上传的本机录音需先上传，阅读与单词进度由学习页面单独保存。</view>
    <view wx:if="{{editable}}" class="actions"><view class="task-action secondary" bindtap="onSave" aria-role="button">{{saving ? '保存中…' : '保存草稿'}}</view><view class="task-action {{hasUnsupportedExercise ? 'task-action--disabled' : 'primary'}}" bindtap="onSubmit" aria-role="button">{{hasUnsupportedExercise ? '暂不可提交' : submitting ? '提交中…' : '提交任务'}}</view></view>
  </view>
</view>
