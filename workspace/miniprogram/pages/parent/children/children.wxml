<g0-page-shell nature="{{true}}" tone="parent"><view class="m1-page"><app-header title="孩子管理"></app-header><view class="m1-content"><text class="m1-title">孩子管理</text><text class="m1-subtitle">已绑定 {{children.length}} / 5</text><state-panel wx:if="{{loading}}" state="loading"></state-panel><state-panel wx:elif="{{error && !showAdd}}" state="error" message="{{error}}" bind:retry="loadChildren"></state-panel><view wx:else><view wx:for="{{children}}" wx:key="id" class="m1-card child-card"><view class="m1-avatar">{{item.displayName}}</view><view class="child-copy"><text class="child-name">{{item.displayName}}</text><text>{{item.className}} · 学号 {{item.studentNumber}}</text><text wx:if="{{item.current}}" class="m1-pill m1-pill--success">当前孩子</text></view><view class="child-actions"><button wx:if="{{!item.current}}" data-id="{{item.id}}" bindtap="selectChild">切换</button><button class="remove" data-id="{{item.id}}" data-version="{{item.linkVersion}}" bindtap="removeChild">解除绑定</button></view></view><view wx:if="{{!children.length}}" class="m1-card m1-empty">尚未绑定孩子，请使用学生编号和教师提供的绑定码添加。</view><view wx:if="{{children.length < 5}}" class="m1-card add-card"><view class="add-symbol">＋</view><text class="m1-section-title">添加孩子</text><text>输入学生编号和 6 位绑定码</text><g0-button wx:if="{{!showAdd}}" bind:action="toggleAdd">添加孩子</g0-button><view wx:else class="add-form"><view class="m1-field"><text class="m1-field-label">学生编号</text><input class="m1-input" value="{{studentNumber}}" placeholder="请输入学生编号" bindinput="onStudentNumber"/></view><view class="m1-field"><text class="m1-field-label">6 位绑定码</text><input class="m1-input" type="number" maxlength="6" value="{{bindingCode}}" placeholder="请输入绑定码" bindinput="onBindingCode"/></view><text wx:if="{{error}}" class="m1-inline-error">{{error}}</text><view class="add-actions"><g0-button variant="secondary" bind:action="toggleAdd">取消</g0-button><g0-button loading="{{submitting}}" bind:action="addChild">确认绑定</g0-button></view></view><text class="validity">绑定码有效期 24 小时</text></view></view></view><g0-tab-bar role="parent" active="children"></g0-tab-bar></view></g0-page-shell>

