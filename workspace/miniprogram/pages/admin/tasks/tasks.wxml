<g0-page-shell tone="teacher">
  <view class="native-admin">
    <view class="native-admin__header"><app-header title="" back="{{true}}"></app-header><text class="native-admin__eyebrow">雅睿英语 / 管理工作区</text><text class="native-admin__title">{{title}}</text></view>
    <state-panel wx:if="{{status === 'loading'}}" state="loading"></state-panel>
    <view wx:elif="{{status === 'forbidden'}}" class="native-admin__notice">当前账号没有本页管理授权。请返回教师“我的”；直接打开页面也不能读取管理数据。</view>
    <state-panel wx:elif="{{status === 'error'}}" state="error" message="{{error}}" bind:retry="reload"></state-panel>
    <block wx:else>

      <view class="native-admin__hero"><text class="native-admin__hero-title">{{title}}</text><text class="native-admin__hero-note">{{subtitle}}</text><text class="native-admin__scope">管理范围　{{scopeLabel}}</text></view>
      <view wx:if="{{pageId === 'A-01'}}" class="native-admin__card"><text class="native-admin__card-title">授权范围概览</text><view wx:if="{{dataLoading}}" class="native-admin__module-note">正在核对概览…</view><view wx:elif="{{dataError}}" class="native-admin__module-note">{{dataError}}<button bindtap="reload">重试</button></view><view wx:elif="{{overview}}" class="native-admin__metrics"><view><text>学校</text><text>{{overview.organizationCount}}</text></view><view><text>班级</text><text>{{overview.classCount}}</text></view><view><text>账号</text><text>{{overview.userCount === null ? '未记录' : overview.userCount}}</text></view><view><text>任务与活动</text><text>{{overview.taskCount === null ? '未记录' : overview.taskCount}}</text></view></view></view>
      <view wx:if="{{pageId === 'A-02'}}" class="native-admin__card"><text class="native-admin__card-title">授权班级</text><text wx:if="{{dataError}}" class="native-admin__module-note">{{dataError}}</text><view wx:for="{{classRows}}" wx:key="id" class="native-admin__module"><view class="native-admin__icon">▦</view><view class="native-admin__module-copy"><text class="native-admin__module-title">{{item.name}}</text><text class="native-admin__module-note">{{item.grade}} / {{item.term}} / {{item.studentCount === null ? '人数未记录' : item.studentCount + ' 名学员'}}</text></view><text class="native-admin__chevron">{{item.status === 'active' ? '启用' : '停用'}}</text></view><text wx:if="{{!dataLoading && !dataError && !classRows.length}}" class="native-admin__module-note">当前授权范围内暂无班级</text><button wx:if="{{nextOffset !== null}}" loading="{{dataLoading}}" bindtap="loadMore">加载更多</button></view>
      <view wx:if="{{pageId === 'A-03'}}" class="native-admin__card"><text class="native-admin__card-title">授权用户</text><view wx:if="{{access && !access.scope.organizationWide}}" class="native-admin__class-chips"><button wx:for="{{access.scope.classIds}}" wx:key="*this" data-id="{{item}}" bindtap="chooseClass" class="{{selectedClassId === item ? 'active' : ''}}">{{item}}</button></view><text wx:if="{{dataError}}" class="native-admin__module-note">{{dataError}}</text><view wx:for="{{userRows}}" wx:key="id" class="native-admin__module"><view class="native-admin__icon">人</view><view class="native-admin__module-copy"><text class="native-admin__module-title">{{item.displayName}}　{{item.roleLabel}}</text><text class="native-admin__module-note">{{item.studentNumber ? '学号 ' + item.studentNumber : '账号资料已脱敏'}}</text></view><text class="native-admin__chevron">{{item.status === 'active' ? '启用' : '停用'}}</text></view><text wx:if="{{!dataLoading && !dataError && !userRows.length}}" class="native-admin__module-note">当前授权范围内暂无用户</text><button wx:if="{{nextOffset !== null}}" loading="{{dataLoading}}" bindtap="loadMore">加载更多</button></view>
      <view wx:if="{{pageId === 'A-04'}}" class="native-admin__card"><text class="native-admin__card-title">当前授权</text><text wx:if="{{dataError}}" class="native-admin__module-note">{{dataError}}</text><view wx:for="{{grantRows}}" wx:key="teacherId" class="native-admin__module"><view class="native-admin__icon">权</view><view class="native-admin__module-copy"><text class="native-admin__module-title">{{item.teacherId}}</text><text class="native-admin__module-note">{{item.organizationWide ? '组织范围' : item.classIds.length + ' 个班级'}} / {{item.permissions.length}} 项权限 / 版本 {{item.version}}</text></view><text class="native-admin__chevron">{{item.status === 'active' ? '有效' : '已撤销'}}</text></view><text wx:if="{{!dataLoading && !dataError && !grantRows.length}}" class="native-admin__module-note">当前范围内暂无授权记录</text><button wx:if="{{nextOffset !== null}}" loading="{{dataLoading}}" bindtap="loadMore">加载更多</button></view>
      <view wx:if="{{pageId === 'A-05' || pageId === 'A-06' || pageId === 'A-07' || pageId === 'A-08'}}" class="native-admin__card"><text class="native-admin__card-title">当前授权目录</text><text wx:if="{{dataError}}" class="native-admin__module-note">{{dataError}}</text><view wx:for="{{recordRows}}" wx:key="id" class="native-admin__module" data-id="{{item.id}}" bindtap="openRecordOperation"><view class="native-admin__icon">▤</view><view class="native-admin__module-copy"><text class="native-admin__module-title">{{item.title}}</text><text class="native-admin__module-note">{{item.detail}}</text><text wx:if="{{pageId === 'A-07'}}" class="native-admin__module-note">{{item.creatorLabel || '创建教师未记录'}} · {{item.classLabel || '班级未记录'}}</text><text wx:if="{{item.startsAt || item.dueAt}}" class="native-admin__module-note">{{item.startsAt || '开始时间未记录'}} 至 {{item.dueAt || '未设截止'}}</text><text wx:if="{{item.participantCount !== undefined}}" class="native-admin__module-note">{{item.completedCount}} / {{item.participantCount}} 人已完成 · {{item.pendingReviewCount}} 人待点评</text></view><text class="native-admin__chevron">{{item.statusLabel}} ›</text></view><text wx:if="{{!dataLoading && !dataError && !recordRows.length}}" class="native-admin__module-note">当前授权范围内暂无记录</text><button wx:if="{{nextOffset !== null}}" loading="{{dataLoading}}" bindtap="loadMore">加载更多</button></view>
      <view wx:if="{{operationDraft}}" class="native-admin__card"><view class="native-admin__form-heading"><text class="native-admin__card-title">{{operationDraft.title}}</text><button bindtap="closeRecordOperation">关闭</button></view><text class="native-admin__module-note">当前版本 {{operationDraft.version}}；结果以服务端核对为准。</text><input wx:if="{{operationDraft.kind === 'textbook'}}" class="native-admin__field" value="{{operationDraft.classIdsText}}" bindinput="onOperationClassIds" placeholder="可见班级 ID，以顿号分隔"/><textarea class="native-admin__field" maxlength="200" value="{{operationDraft.reason}}" bindinput="onOperationReason" placeholder="填写操作原因"/><text wx:if="{{operationError}}" class="native-admin__notice">{{operationError}}；输入已保留，可重试。</text><view class="native-admin__form-actions"><button wx:if="{{operationDraft.kind === 'textbook'}}" data-action="save" loading="{{operationBusy}}" disabled="{{operationBusy}}" bindtap="requestRecordOperation">保存配置草稿</button><block wx:elif="{{operationDraft.kind === 'question'}}"><button data-action="publish" loading="{{operationBusy}}" disabled="{{operationBusy}}" bindtap="requestRecordOperation">上架习题</button><button data-action="offline" loading="{{operationBusy}}" disabled="{{operationBusy}}" bindtap="requestRecordOperation">下架习题</button></block><button wx:elif="{{operationDraft.kind === 'classroom' || operationDraft.kind === 'activity'}}" data-action="stop" loading="{{operationBusy}}" disabled="{{operationBusy}}" bindtap="requestRecordOperation">停用并保留历史</button></view></view>
      <view class="native-admin__card"><text class="native-admin__card-title">导出授权清单</text><text class="native-admin__module-note">仅包含当前账号有权查看的课堂任务与打卡活动，最多 2000 条。</text><text wx:if="{{exportError}}" class="native-admin__notice">{{exportError}}</text><button loading="{{exportBusy}}" disabled="{{exportBusy}}" bindtap="exportAuthorizedTasks">复制 CSV 清单</button></view>
      <view class="native-admin__search"><input value="{{keyword}}" placeholder="{{filterPlaceholder}}" confirm-type="search" bindinput="onKeyword" bindconfirm="applyFilters"/></view>
      <view wx:if="{{pageId === 'A-05' || pageId === 'A-06' || pageId === 'A-07' || pageId === 'A-08'}}" class="native-admin__filter-panel">
        <view class="native-admin__filter-row">
          <button data-status="all" bindtap="onStatusFilter" class="{{statusFilter === '' ? 'active' : ''}}">全部</button>
          <button wx:if="{{pageId === 'A-05'}}" data-status="draft" bindtap="onStatusFilter" class="{{statusFilter === 'draft' ? 'active' : ''}}">草稿</button>
          <button wx:if="{{pageId === 'A-05'}}" data-status="published" bindtap="onStatusFilter" class="{{statusFilter === 'published' ? 'active' : ''}}">已发布</button>
          <button wx:if="{{pageId === 'A-05'}}" data-status="disabled" bindtap="onStatusFilter" class="{{statusFilter === 'disabled' ? 'active' : ''}}">已停用</button>
          <button wx:if="{{pageId === 'A-06'}}" data-status="published" bindtap="onStatusFilter" class="{{statusFilter === 'published' ? 'active' : ''}}">已上架</button>
          <button wx:if="{{pageId === 'A-06'}}" data-status="offline" bindtap="onStatusFilter" class="{{statusFilter === 'offline' ? 'active' : ''}}">已下架</button>
          <button wx:if="{{pageId === 'A-07'}}" data-status="scheduled" bindtap="onStatusFilter" class="{{statusFilter === 'scheduled' ? 'active' : ''}}">待开始</button><button wx:if="{{pageId === 'A-07'}}" data-status="published" bindtap="onStatusFilter" class="{{statusFilter === 'published' ? 'active' : ''}}">已发布</button><button wx:if="{{pageId === 'A-07'}}" data-status="active" bindtap="onStatusFilter" class="{{statusFilter === 'active' ? 'active' : ''}}">进行中</button>
          <button wx:if="{{pageId === 'A-07'}}" data-status="completed" bindtap="onStatusFilter" class="{{statusFilter === 'completed' ? 'active' : ''}}">已完成</button>
          <button wx:if="{{pageId === 'A-07'}}" data-status="closed" bindtap="onStatusFilter" class="{{statusFilter === 'closed' ? 'active' : ''}}">已关闭</button><button wx:if="{{pageId === 'A-07'}}" data-status="expired" bindtap="onStatusFilter" class="{{statusFilter === 'expired' ? 'active' : ''}}">已过期</button><button wx:if="{{pageId === 'A-07'}}" data-status="withdrawn" bindtap="onStatusFilter" class="{{statusFilter === 'withdrawn' ? 'active' : ''}}">已撤回</button>
          <button wx:if="{{pageId === 'A-08'}}" data-status="pending_review" bindtap="onStatusFilter" class="{{statusFilter === 'pending_review' ? 'active' : ''}}">待审核</button>
          <button wx:if="{{pageId === 'A-08'}}" data-status="approved" bindtap="onStatusFilter" class="{{statusFilter === 'approved' ? 'active' : ''}}">待上架</button>
          <button wx:if="{{pageId === 'A-08'}}" data-status="published" bindtap="onStatusFilter" class="{{statusFilter === 'published' ? 'active' : ''}}">已上架</button>
        </view>
        <view wx:if="{{pageId === 'A-07'}}" class="native-admin__filter-row">
          <button data-type="all" bindtap="onTaskTypeFilter" class="{{taskTypeFilter === 'all' ? 'active' : ''}}">全部类型</button>
          <button data-type="classroom" bindtap="onTaskTypeFilter" class="{{taskTypeFilter === 'classroom' ? 'active' : ''}}">课堂任务</button>
          <button data-type="activity" bindtap="onTaskTypeFilter" class="{{taskTypeFilter === 'activity' ? 'active' : ''}}">打卡活动</button>
        </view>
        <view wx:if="{{pageId === 'A-07'}}" class="native-admin__filter-row">
          <picker mode="date" data-field="fromDate" value="{{fromDate}}" bindchange="onRecordDate"><view class="native-admin__date-filter">开始 {{fromDate || '不限'}}</view></picker>
          <picker mode="date" data-field="toDate" value="{{toDate}}" bindchange="onRecordDate"><view class="native-admin__date-filter">结束 {{toDate || '不限'}}</view></picker>
        </view>
        <button class="native-admin__filter-submit" loading="{{dataLoading}}" disabled="{{dataLoading}}" bindtap="applyFilters">搜索与筛选</button>
      </view>
      <view class="native-admin__card"><text class="native-admin__card-title">{{pageId === 'A-01' ? '管理模块' : '当前模块'}}</text>
        <view wx:for="{{filteredModules}}" wx:key="id" class="native-admin__module" data-id="{{item.id}}" bindtap="openModule" aria-role="button" aria-label="{{item.title}}">
          <view class="native-admin__icon">▣</view><view class="native-admin__module-copy"><text class="native-admin__module-title">{{item.title}}</text><text class="native-admin__module-note">{{item.description}}</text></view><text class="native-admin__chevron">{{item.route ? '›' : '待接入'}}</text>
        </view><text wx:if="{{!filteredModules.length}}" class="native-admin__module-note">没有匹配的模块</text>
      </view>
      <view wx:if="{{pageId !== 'A-01'}}" class="native-admin__notice">此页已按当前账号逐次核对管理授权。业务数据与写操作须接入受保护服务后开放；当前不会显示演示数字或执行管理变更。</view>
    </block>
  </view>
  <g0-tab-bar role="teacher" active="mine"></g0-tab-bar>
</g0-page-shell>