<g0-page-shell nature="{{true}}" tone="nature"><view class="page" style="padding-top: {{topInset}}px;">
  <view class="hero"><view class="brand-lockup"><image src="/assets/g0/brand-logo.png" class="crest" mode="aspectFit"/><view><text class="brand">雅睿英语</text><text class="sub">让英语学习更有趣</text></view></view><image src="/assets/g0/mascot-learning-blue.png" class="login-mascot" mode="widthFix"/></view>
  <g0-card kind="student">
    <text class="title">账号登录</text>
    <g0-input label="手机号" value="{{mobile}}" type="number" maxlength="11" placeholder="请输入手机号" bind:input="onMobile"><view slot="prefix" class="field-icon phone-icon"></view></g0-input>
    <g0-input label="密码" value="{{password}}" type="text" maxlength="32" password="{{!showPassword}}" placeholder="请输入密码" error="{{error}}" bind:input="onPassword"><view slot="prefix" class="field-icon lock-icon"></view><view slot="suffix" class="password-toggle {{showPassword ? 'is-visible' : ''}}" bindtap="togglePassword" aria-role="button" aria-label="显示或隐藏密码"><view class="eye-shape"></view></view></g0-input>
    <view class="login-action"><g0-button loading="{{loading}}" bind:action="submit">登录</g0-button></view>
    <text class="forgot" bindtap="forgotPassword">忘记密码</text>
  </g0-card>
  </view></g0-page-shell>
