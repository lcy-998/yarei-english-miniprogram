<g0-page-shell nature="{{true}}" tone="nature"><view class="page"><app-header title="找回密码" back="{{true}}" backUrl="/pages/auth/login/login"></app-header>
  <view class="steps"><view class="active"><text>1</text><text>验证手机号</text></view><view class="line"></view><view class="{{step === 2 ? 'active' : ''}}"><text>2</text><text>设置新密码</text></view></view>
  <text class="hint">{{step === 1 ? '请先验证手机号，再设置新密码' : '请设置 6—32 位新密码'}}</text>
  <view class="card" wx:if="{{step === 1}}"><text class="label">手机号</text><input type="number" maxlength="11" placeholder="请输入手机号" value="{{mobile}}" bindinput="onMobile"/><text class="label">验证码</text><view class="code-row"><input type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCode"/><button bindtap="sendCode" loading="{{loading}}" disabled="{{countdown > 0}}">{{codeButtonLabel}}</button></view><text wx:if="{{error}}" class="error">{{error}}</text><button class="primary" bindtap="nextStep">下一步</button><button class="link" bindtap="backToLogin">返回登录</button></view>
  <view class="card" wx:else><text class="label">新密码</text><input password placeholder="请输入新密码" value="{{newPassword}}" bindinput="onNewPassword"/><text class="label">确认新密码</text><input password placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmPassword"/><text wx:if="{{error}}" class="error">{{error}}</text><button class="primary" bindtap="submit" loading="{{loading}}">完成设置</button></view>
</view></g0-page-shell>
