<g0-page-shell nature="{{true}}" tone="nature"><view class="page"><app-header title="{{recoveryAvailable ? '设置密码' : '账号帮助'}}" back="{{true}}" backUrl="/pages/auth/login/login"></app-header>
  <view wx:if="{{!recoveryAvailable}}" class="card recovery-help">
    <text class="label">账号与密码帮助</text>
    <text class="help-copy">当前暂不提供短信验证码找回密码。首次使用、忘记密码或需要修改密码，请联系运营者核验账号归属后处理。</text>
    <text class="help-copy">运营者：{{operatorName}}</text>
    <text class="help-copy" user-select="{{true}}">{{privacyContact}}</text>
    <text class="help-copy">请勿向他人提供现有密码、验证码或无关证件信息。本页不收集手机号，也不会发送验证码。</text>
    <button class="primary" bindtap="backToLogin">返回</button>
  </view>
  <block wx:else>
  <legal-consent accepted="{{accepted}}" disabled="{{loading}}" bind:change="onConsent"/>
  <view class="steps"><view class="active"><text>1</text><text>验证手机号</text></view><view class="line"></view><view class="{{step === 2 ? 'active' : ''}}"><text>2</text><text>设置新密码</text></view></view>
  <text class="hint">{{step === 1 ? '首次设置或忘记密码，都先验证本人手机号' : verificationCountdownLabel}}</text>
  <view class="card" wx:if="{{step === 1}}"><text class="label">手机号</text><input disabled="{{!accepted || loading}}" type="number" maxlength="11" placeholder="请输入手机号" value="{{mobile}}" bindinput="onMobile"/><text class="label">验证码</text><view class="code-row"><input disabled="{{!accepted || loading}}" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCode"/><button bindtap="sendCode" loading="{{loading}}" disabled="{{loading || countdown > 0}}">{{codeButtonLabel}}</button></view><text wx:if="{{error}}" class="error">{{error}}</text><button class="primary" bindtap="nextStep" loading="{{loading}}" disabled="{{loading}}">下一步</button><button class="link" bindtap="backToLogin">返回登录</button></view>
  <view class="card" wx:else><text class="label">新密码</text><input disabled="{{!accepted || loading}}" password placeholder="请输入新密码" value="{{newPassword}}" bindinput="onNewPassword"/><text class="label">确认新密码</text><input disabled="{{!accepted || loading}}" password placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmPassword"/><text wx:if="{{error}}" class="error">{{error}}</text><button class="primary" bindtap="submit" loading="{{loading}}" disabled="{{loading || verificationSecondsRemaining <= 0}}">完成设置</button><button wx:if="{{verificationSecondsRemaining <= 0}}" class="link" bindtap="restartVerification">重新验证手机号</button></view>
  </block>
</view></g0-page-shell>
