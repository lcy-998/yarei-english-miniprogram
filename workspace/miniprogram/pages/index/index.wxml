<g0-page-shell nature="{{true}}" tone="nature"><view class="home-page">
  <view class="nature-top" style="padding-top: {{topInset}}px; min-height: {{heroHeight}}px;">
    <view class="brand-row"><image src="/assets/g0/brand-logo.png" class="crest" mode="aspectFit"/><text>雅睿英语</text><view class="notice" bindtap="openNotice" aria-role="button" aria-label="通知"><view class="notice-bell"></view><text wx:if="{{noticeCount}}" class="notice-count">{{noticeCount > 99 ? '99+' : noticeCount}}</text></view></view>
    <view class="welcome"><view><text class="hello">嗨，{{home.user.displayName}}</text><text class="class-name">{{className || '班级待分配'}}　{{dateLabel}}</text></view><image src="/assets/g0/mascot-learning-blue.png" class="mascot" mode="widthFix"/></view>
  </view>
  <state-panel wx:if="{{loading}}" state="loading"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadHome"></state-panel>
  <block wx:elif="{{home}}">
    <view wx:if="{{todayItems.length}}" class="task-card {{checkinOnly ? 'task-card--checkin' : ''}}">
      <view class="task-head"><view class="task-heading"><g0-icon name="calendar" tone="primary" size="{{48}}"></g0-icon><text>今日任务</text></view><text class="progress">完成 {{todayCompletedCount}}/{{todayTotalCount}}</text></view>
      <view class="thin-progress"><view class="thin-progress__done" style="width: {{todayTotalCount ? todayCompletedCount * 100 / todayTotalCount : 0}}%;"></view></view>
      <view wx:for="{{todayItems}}" wx:key="key" class="task-body {{item.kind === 'activity' ? 'task-body--checkin' : ''}} {{item.completed ? 'task-body--completed' : ''}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openTodayItem" hover-class="task-body--pressed" aria-role="button" aria-label="{{item.kind === 'activity' ? '打开打卡任务' : '打开学习任务'}}">
        <g0-icon name="{{item.kind === 'activity' ? 'calendar' : 'publish'}}" tone="{{item.kind === 'activity' ? 'yellow' : 'primary'}}" size="68"></g0-icon><view class="task-copy"><text class="task-title">{{item.title}}</text><view class="due"><view class="clock" aria-hidden="true"></view><text>{{item.dueLabel}}</text></view></view>
      </view>
    </view>
    <view wx:else class="task-card complete"><view class="task-head"><text>今日任务</text><text class="progress">完成 {{todayCompletedCount}}/{{todayTotalCount}}</text></view><text class="complete-copy">今日任务已完成</text></view>
    <view class="vocabulary-card" bindtap="openVocabulary" hover-class="vocabulary-card--pressed" aria-role="button" aria-label="进入单词练习"><g0-icon name="word" size="{{70}}" tone="warning"></g0-icon><view class="vocabulary-copy"><text class="vocabulary-title">单词练习</text><text class="vocabulary-sub">从今天的词包开始</text></view><view class="chevron chevron--round" aria-hidden="true"></view></view>
  </block>
  <g0-tab-bar role="student" active="home"></g0-tab-bar>
</view></g0-page-shell>
