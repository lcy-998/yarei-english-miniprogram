<g0-page-shell nature="{{true}}" tone="teacher"><view class="textbook-page"><app-header title="阅读内容选择" back="{{true}}" backUrl="/pages/teacher/materials-home/materials-home" backIntercept="{{true}}" bind:back="onNavigateBack"></app-header><view class="textbook-content"><view class="reading-categories"><button wx:for="{{categories}}" wx:key="value" data-value="{{item.value}}" class="{{category === item.value ? 'active' : ''}}" bindtap="chooseCategory">{{item.label}}</button></view><view class="textbook-card"><input class="textbook-input" placeholder="书名或内容关键词" value="{{keyword}}" data-key="keyword" bindinput="input"/><view class="textbook-filter-row"><picker range="{{gradeOptions}}" range-key="label" value="{{gradeIndex}}" bindchange="chooseGrade"><view class="reading-filter-picker">{{gradeOptions[gradeIndex].label}}<text>⌄</text></view></picker><picker range="{{difficultyOptions}}" range-key="label" value="{{difficultyIndex}}" bindchange="chooseDifficulty"><view class="reading-filter-picker">{{difficultyOptions[difficultyIndex].label}}<text>⌄</text></view></picker></view><button class="textbook-primary" bindtap="search" disabled="{{loading}}">查找阅读资源</button></view>
  <state-panel wx:if="{{loading}}" state="loading" message="正在加载阅读内容"></state-panel><state-panel wx:elif="{{error && !rows.length}}" state="error" message="{{error}}" bind:retry="retry"></state-panel><view wx:else><text wx:if="{{error}}" class="textbook-error">{{error}}</text><view wx:for="{{rows}}" wx:key="id" class="textbook-card reading-card reading-card--{{item.category || 'other'}}"><view class="reading-resource-row"><image wx:if="{{item.id === 'res_reading_zoo_demo' || item.id === 'book_zoo'}}" class="reading-resource-cover" src="/assets/content/demo-zoo-cover-thumb-v1.png" mode="aspectFit" aria-hidden="true"></image><image wx:elif="{{item.id === 'res_m2_sync_book_outline_demo'}}" class="reading-resource-cover" src="/assets/content/demo-sync-textbook-cover-thumb-v1.png" mode="aspectFit" aria-hidden="true"></image><view wx:else class="reading-resource-icon reading-resource-icon--{{item.category || 'other'}}"><g0-icon name="reading" tone="{{item.category === 'synchronized' || item.category === 'chapter_book' ? 'success' : item.category === 'current_events' ? 'ai' : item.category === 'picture_book' ? 'warning' : 'primary'}}" size="{{42}}"></g0-icon></view><view class="reading-resource-copy"><text class="textbook-card-title">{{item.title}}</text><view class="reading-facts"><text class="reading-grade">{{item.grade}}</text><text wx:if="{{item.difficulty}}" class="reading-level">{{item.difficulty}}</text><text class="reading-count">{{item.requiredCount}} 页</text></view><text class="textbook-chip reading-category-tag reading-category-tag--{{item.category || 'other'}}">{{item.category === 'synchronized' ? '同步课本' : item.category === 'original' ? '原版材料' : item.category === 'picture_book' ? '绘本阅读' : item.category === 'current_events' ? '时文阅读' : item.category === 'chapter_book' ? '章节阅读' : '阅读书籍'}}</text></view></view><view class="textbook-card-actions"><button data-id="{{item.id}}" bindtap="previewBook">预览并选择范围</button></view></view><view wx:if="{{!rows.length && nextOffset === null}}" class="textbook-card textbook-empty">当前分类没有授权阅读内容，可切换分类或调整条件。</view><view wx:elif="{{!rows.length}}" class="textbook-card textbook-empty">当前批次没有匹配项，可继续加载。</view><button wx:if="{{nextOffset !== null}}" class="textbook-primary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多</button></view></view>
  <view wx:if="{{preview}}" class="reading-preview" bindtap="closePreview"><view class="reading-preview-panel" catchtap="noop"><text class="textbook-card-title">{{preview.title}}</text><text class="textbook-card-meta">{{preview.grade}}　{{preview.difficulty}}　{{pages.length}} 页</text><view class="textbook-card"><text class="textbook-card-title">目录</text><view wx:for="{{preview.chapters}}" wx:key="id" class="textbook-card-meta">{{item.title}}　{{item.pages.length}} 页</view></view><view class="textbook-card"><text class="textbook-card-title">阅读范围</text><view class="textbook-card-actions"><button data-mode="whole" bindtap="chooseMode">{{mode === 'whole' ? '✓ ' : ''}}整本</button><button data-mode="chapter" bindtap="chooseMode">{{mode === 'chapter' ? '✓ ' : ''}}章节</button><button data-mode="range" bindtap="chooseMode">{{mode === 'range' ? '✓ ' : ''}}指定页</button></view><view wx:if="{{mode === 'chapter'}}" class="chapter-list"><button wx:for="{{preview.chapters}}" wx:key="id" class="chapter-option {{chapterId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseChapter"><text class="chapter-name">{{item.title}}</text><text class="chapter-page-count">{{item.pages.length}} 页</text></button></view><view wx:if="{{mode === 'range'}}" class="range-row"><picker range="{{pages}}" range-key="label" value="{{fromIndex}}" bindchange="chooseFrom"><view class="range-picker"><text class="range-picker-label">起始页</text><text class="range-picker-value">{{pages[fromIndex].label}}</text><view class="range-picker-arrow" aria-hidden="true"></view></view></picker><picker range="{{pages}}" range-key="label" value="{{toIndex}}" bindchange="chooseTo"><view class="range-picker"><text class="range-picker-label">结束页</text><text class="range-picker-value">{{pages[toIndex].label}}</text><view class="range-picker-arrow" aria-hidden="true"></view></view></picker></view></view><text wx:if="{{error}}" class="textbook-error">{{error}}</text><view class="reading-preview-actions"><button class="textbook-primary" loading="{{confirming}}" disabled="{{confirming || !pages.length}}" bindtap="confirm">布置任务</button><button class="textbook-secondary" bindtap="closePreview">返回列表</button></view></view></view></view></g0-page-shell>
