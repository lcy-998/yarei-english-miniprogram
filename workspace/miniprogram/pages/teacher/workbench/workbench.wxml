<g0-page-shell nature="{{true}}" tone="teacher"><view class="page" bindtap="closeClassFilter">
  <app-header title="" showBell="{{true}}" bellCount="{{noticeCount}}"></app-header>
  <view class="brand-header"><image src="/assets/g0/brand-logo.png" mode="aspectFit"></image><view><text>雅睿英语</text><text>教师工作台</text></view></view>
  <state-panel wx:if="{{loading}}" state="loading" message="正在加载教师工作台"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadWorkbench"></state-panel>
  <view wx:else class="content">
    <view class="greeting-row"><text>{{teacherName}}，{{greeting}}</text><view class="workbench-class-filter"><button bindtap="toggleClassFilter" aria-label="筛选班级：{{selectedClass}}"><text class="filter-label">{{selectedClassId ? selectedClass : '全部班级'}}</text><view class="filter-arrow {{classFilterOpen ? 'is-open' : ''}}" aria-hidden="true"></view></button><view wx:if="{{classFilterOpen}}" class="workbench-class-menu"><view wx:for="{{classOptions}}" wx:key="id" class="workbench-class-option {{selectedClassId === item.id ? 'selected' : ''}}" data-class-id="{{item.id}}" bindtap="selectClass">{{item.name}}</view></view></view></view>

    <view class="quick-grid">
      <view class="quick quick--blue" bindtap="goPublish" aria-role="button"><g0-icon name="publish" size="{{54}}"></g0-icon><text>布置任务</text></view>
      <view class="quick quick--green" bindtap="goCheckTasks" aria-role="button"><g0-icon name="check" tone="success" size="{{54}}"></g0-icon><text>检查任务</text></view>
      <view class="quick quick--purple" bindtap="goReview" aria-role="button"><g0-icon name="review" tone="ai" size="{{54}}"></g0-icon><text>快速点评</text></view>
    </view>
    <view class="today-card">
      <view class="card-title"><g0-icon name="calendar" size="{{42}}"></g0-icon><text>今日待办</text></view>
      <view class="todo-grid"><view><g0-icon name="check" tone="success" size="{{46}}"></g0-icon><view><text>待检查</text><text>{{pendingCount}}</text></view></view><view><g0-icon name="review" tone="warning" size="{{46}}"></g0-icon><view><text>待点评</text><text>{{pendingCommentCount}}</text></view></view></view>
      <view wx:if="{{recentTaskId}}" class="task-row" bindtap="goRecentTask" aria-role="button"><g0-icon name="task" size="{{44}}"></g0-icon><view><text>{{recentTaskTitle}}</text><text>{{recentTaskClassName}}</text></view><text><text>{{submittedCount}}</text>/{{authorizedStudentCount}} 已提交</text><view class="row-arrow" aria-hidden="true"></view></view>
      <view wx:else class="task-empty">暂无进行中的课堂任务</view>
    </view>

    <view class="ongoing-card">
      <view class="card-title"><g0-icon name="task" size="{{42}}"></g0-icon><text>进行中</text></view>
      <view class="ongoing-grid"><button bindtap="goCenter"><g0-icon name="task" size="{{46}}"></g0-icon><view><text>课堂任务</text><text>{{activeClassroomCount}}</text></view></button><button bindtap="goActivities"><g0-icon name="check" tone="success" size="{{46}}"></g0-icon><view><text>打卡活动</text><text>{{activityCount}}</text></view></button></view>
    </view>

    <view class="class-update" bindtap="goStats" aria-role="button"><g0-icon name="review" tone="ai" size="{{40}}"></g0-icon><view><text>班级动态</text><text>{{classUpdateText}}</text></view><text>学员统计</text><view class="row-arrow" aria-hidden="true"></view></view>
  </view>
  <g0-tab-bar role="teacher" active="workbench"></g0-tab-bar>
</view></g0-page-shell>
