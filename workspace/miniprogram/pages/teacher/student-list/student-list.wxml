<g0-page-shell tone="teacher">
  <view class="m1-page teacher-students" bindtap="closeClassMenu">
    <view class="student-list-background" aria-hidden="true"></view>
    <view class="student-list-foreground">
      <app-header title=""></app-header>
      <view class="teacher-brand"><image src="/assets/g0/brand-logo.png" mode="aspectFit"></image><view><text>雅睿英语</text><text>教师工作台</text></view></view>
      <view class="m1-content">
        <view class="list-heading"><text class="m1-title">学员列表</text><view class="class-filter-wrap"><button class="class-filter" bindtap="chooseClass">{{selectedClass}}<text class="filter-arrow {{classFilterOpen ? 'is-open' : ''}}"></text></button><view wx:if="{{classFilterOpen}}" class="class-menu"><view wx:for="{{classOptions}}" wx:key="id" class="class-option {{selectedClassId === item.id ? 'selected' : ''}}" data-class-id="{{item.id}}" bindtap="selectClass">{{item.name}}</view></view></view></view>
        <button class="stats-entry" bindtap="openStats">查看学员统计 ›</button>
        <view class="control-panel">
          <view class="m1-toolbar"><view class="search-wrap"><view class="search-symbol"></view><input value="{{keyword}}" placeholder="搜索姓名或学号" bindinput="onSearch"/></view><picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange"><view class="status-filter">{{statusOptions[statusIndex].label}}<text class="filter-arrow"></text></view></picker></view>
          <view class="list-tools"><button class="import" bindtap="importStudents"><view class="tool-icon">↑</view><text>批量导入</text></button><button class="export" bindtap="exportStudents"><view class="tool-icon">≡</view><text>复制 CSV</text></button><button class="primary" bindtap="addStudent"><view class="tool-icon">＋</view><text>新建学员</text></button></view>
        </view>
        <view wx:if="{{importPreviewOpen}}" class="m1-card import-panel">
          <view class="import-heading"><view><text class="import-title">批量导入预检</text><text class="import-subtitle">仅检查本地 CSV，不会创建账号</text></view><button bindtap="closeImportPreview">关闭</button></view>
          <view class="import-actions"><button bindtap="copyImportTemplate">复制 CSV 模板</button><button class="import-pick" loading="{{importBusy}}" bindtap="chooseImportFile">选择文件并检查</button></view>
          <view wx:if="{{importPreview}}" class="import-result"><text class="import-file">{{importFileName}}</text><view class="import-counts"><text>总行数 {{importPreview.totalRowCount}}</text><text>可用 {{importPreview.readyRowCount}}</text><text>错误 {{importPreview.rejectedRowCount}}</text></view><text wx:if="{{importPreview.blocked}}" class="import-warning">文件结构错误，请按模板修正后重新选择。</text><view wx:for="{{visibleImportErrors}}" wx:key="*this" class="import-error">第 {{item.lineNumber}} 行　{{item.field}}：{{item.message}}</view><text wx:if="{{importPreview.errors.length > visibleImportErrors.length}}" class="import-more">另有 {{importPreview.errors.length - visibleImportErrors.length}} 条错误，可复制完整结果。</text><button wx:if="{{importPreview.errors.length}}" class="import-copy-errors" bindtap="copyImportErrors">复制错误行 CSV</button><text class="import-note">预检不核对其他学校账号或既有手机号；正式导入须由受保护的账号流程再次校验。</text></view>
        </view>
        <state-panel wx:if="{{loading}}" state="loading"></state-panel>
        <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadStudents"></state-panel>
        <view wx:else class="student-list"><view wx:for="{{students}}" wx:key="studentId" class="student-card student-card--{{item.needsAttention ? 'follow_up' : item.accountStatus}}" data-id="{{item.studentId}}" bindtap="openStudent"><view class="student-avatar">{{item.displayName}}</view><view class="student-copy"><view class="student-head"><text class="student-name">{{item.displayName}}</text><text class="status {{item.accountStatus === 'active' && !item.needsAttention ? 'status--success' : 'status--urgent'}}">{{item.statusLabel}}</text></view><text class="student-meta">学号 {{item.studentNumber}}</text><text class="student-meta">{{item.classInfo.name}}</text></view><view class="m1-chevron"></view><view class="student-progress"><text>任务完成 <text>{{item.performance.completedCount}}/{{item.performance.assignedCount}}</text></text><text>{{item.completionPercent}}%</text><view class="m1-progress"><view style="width: {{item.completionPercent}}%"></view></view></view></view><view wx:if="{{!students.length}}" class="m1-card m1-empty">当前筛选下暂无学员。</view><button wx:if="{{nextCursor}}" class="load-more" loading="{{loadingMore}}" bindtap="loadMore">加载更多　已显示 {{students.length}}/{{total}}</button></view>
      </view>
      <g0-tab-bar role="teacher" active="students"></g0-tab-bar>
    </view>
  </view>
</g0-page-shell>
