<g0-page-shell tone="teacher"><view class="m1-page detail-page"><app-header title="学员详情" back="{{true}}" backUrl="/pages/teacher/student-list/student-list"></app-header><state-panel wx:if="{{loading}}" state="loading"></state-panel><state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadStudent"></state-panel><view wx:elif="{{student}}" class="m1-content"><view class="m1-card student-head"><view class="m1-avatar">{{student.displayName}}</view><view class="student-head-copy"><view><text class="student-name">{{student.displayName}}</text><text class="m1-pill m1-pill--success">{{student.statusLabel}}</text></view><text>{{student.className}} · 学号 {{student.studentNumber}}</text><text>家长：{{student.guardianName}}</text><text>手机号：{{student.guardianMaskedMobile}}</text></view><button class="outline" bindtap="editStudent">编辑资料</button></view><view class="metric-grid"><view class="metric"><view class="metric-icon metric-icon--tasks"><view></view></view><view><text>任务完成率</text><text>{{student.completionPercent}}%</text></view></view><view class="metric success"><view class="metric-icon metric-icon--score"><view></view></view><view><text>平均成绩</text><text>{{student.averageScore}}</text></view></view></view><view class="m1-tabs"><view class="m1-tab {{currentTab === 'tasks' ? 'm1-tab--active' : ''}}" data-tab="tasks" bindtap="setTab">任务记录</view><view class="m1-tab {{currentTab === 'scores' ? 'm1-tab--active' : ''}}" data-tab="scores" bindtap="setTab">成绩记录</view></view><view class="m1-card records"><text class="m1-section-title">{{currentTab === 'tasks' ? '最近任务' : '近 30 天成绩'}}</text><view wx:for="{{student.recentTasks}}" wx:key="id" class="m1-row"><view class="m1-row-copy"><text class="m1-row-title">{{item.title}}</text><text class="m1-row-note">{{item.statusLabel}}</text></view><text wx:if="{{item.score !== undefined}}" class="score">{{item.score}} 分</text></view><view wx:if="{{!student.recentTasks.length}}" class="m1-empty">该学员暂无对应记录。</view></view><view class="m1-card guardian"><text class="m1-section-title">家长关系</text><text>{{student.guardianName}}</text><text>手机号：{{student.guardianMaskedMobile}}</text></view><view class="bottom-actions"><g0-button bind:action="startTask">发起任务</g0-button><g0-button variant="secondary" bind:action="transferStudent">转班</g0-button><g0-button variant="secondary" bind:action="disableStudent">停用</g0-button></view></view></view></g0-page-shell>

