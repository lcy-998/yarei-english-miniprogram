<g0-page-shell tone="teacher">
  <view class="m1-page detail-page">
    <app-header title="学员详情" back="{{true}}" backUrl="/pages/teacher/student-list/student-list"></app-header>
    <state-panel wx:if="{{loading}}" state="loading"></state-panel>
    <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadStudent"></state-panel>
    <view wx:elif="{{student}}" class="m1-content">
      <view class="m1-card student-head"><view class="m1-avatar">{{student.displayName}}</view><view class="student-head-copy"><view><text class="student-name">{{student.displayName}}</text><text class="m1-pill m1-pill--success">{{student.accountStatus === 'active' ? '正常' : '已停用'}}</text></view><text>{{student.classInfo.name}}　学号 {{student.studentNumber}}</text></view><button class="outline" disabled="{{saving}}" bindtap="editStudent">编辑资料</button></view>
      <view class="metric-grid"><view class="metric"><view class="metric-icon metric-icon--tasks"><view></view></view><view><text>任务完成率</text><text>{{student.performance.completionRate}}%</text></view></view><view class="metric success"><view class="metric-icon metric-icon--score"><view></view></view><view><text>平均成绩</text><text>{{student.performance.averageScore === null ? '--' : student.performance.averageScore}}</text></view></view></view>
      <view class="m1-tabs"><view class="m1-tab {{currentTab === 'tasks' ? 'm1-tab--active' : ''}}" data-tab="tasks" bindtap="setTab">任务记录</view><view class="m1-tab {{currentTab === 'scores' ? 'm1-tab--active' : ''}}" data-tab="scores" bindtap="setTab">成绩记录</view></view>
      <view class="m1-card records"><text class="m1-section-title">{{currentTab === 'tasks' ? '最近任务' : '已评分任务'}}</text><view wx:for="{{visibleTasks}}" wx:key="taskId" class="m1-row"><view class="m1-row-copy"><text class="m1-row-title">{{item.title}}</text><text class="m1-row-note">{{item.status}}</text></view><text wx:if="{{item.score !== null}}" class="score">{{item.score}} 分</text></view><view wx:if="{{!visibleTasks.length}}" class="m1-empty">该学员暂无对应记录。</view></view>
      <view class="m1-card guardian"><text class="m1-section-title">家长关系</text><view wx:for="{{student.parents}}" wx:key="linkId" class="guardian-row"><text>{{item.displayNameMasked}}</text><text>{{item.mobileMasked || '未提供手机号'}}</text></view><text wx:if="{{!student.parents.length}}">暂无有效家长关系</text></view>
      <view class="m1-card manage-actions"><text class="m1-section-title">学员管理</text><g0-button bind:action="startTask">为该学员发起任务</g0-button><view wx:if="{{classes.length}}" class="transfer-row"><picker range="{{classes}}" range-key="name" value="{{transferClassIndex}}" bindchange="onTransferClassChange"><view class="transfer-choice">转入 {{classes[transferClassIndex].name}} ›</view></picker><button disabled="{{saving}}" bindtap="transferStudent">确认转班</button></view><button class="status-action" disabled="{{saving}}" bindtap="disableStudent">{{student.accountStatus === 'active' ? '停用学员' : '恢复学员'}}</button></view>
    </view>
  </view>
</g0-page-shell>
