<view class="page page--secondary">
  <image class="page-bg" src="/assets/g0/student-public-natural-background-v1.jpg" mode="scaleToFill" aria-hidden="true"></image>
    <app-header title="{{editTaskId ? '编辑课堂任务' : '布置课堂任务'}}" back="{{true}}"></app-header>
  <view wx:if="{{resumePublication}}" class="content"><view class="section"><text class="section-title">{{title}}正在发布</text><text class="section-note">正在为 {{resumePublication.totalCount}} 名学员建立任务记录。完成后学生才会看到任务；中断后可在任务列表中继续发布。</text></view><text wx:if="{{error}}" class="error">{{error}}</text></view>
  <view wx:else class="content">
    <view class="steps"><view class="step active"><text>1</text><text>任务内容</text></view><view class="step-line active"></view><view class="step active"><text>2</text><text>发布对象</text></view><view class="step-line active"></view><view class="step active"><text>3</text><text>确认发布</text></view></view>
    <view class="section content-section"><view class="section-head"><view><text class="section-title">任务内容</text><text class="section-note">{{editingStatus && editingStatus !== 'draft' && editingStatus !== 'scheduled' ? '进行中的内容与对象保持原快照' : targetCount ? '从当前授权资源中选择，至少保留一项' : '可先选择内容，发布前再选布置对象'}}</text></view><g0-icon name="task" size="70"></g0-icon></view><view class="selected-content"><view class="selected-mark"></view><view><text>课堂任务内容</text><text>{{resourceSummary}}</text></view><text>{{draftOptions && draftOptions.structuredDraft.items.length ? '已选择' : '待选择'}}</text></view><button class="resource-trigger" wx:if="{{!editingStatus || editingStatus === 'draft' || editingStatus === 'scheduled'}}" disabled="{{optionsLoading || loading}}" bindtap="openContentCatalog">添加或调整任务内容</button><view wx:if="{{!editingStatus || editingStatus === 'draft' || editingStatus === 'scheduled'}}" class="content-shortcuts"><button disabled="{{optionsLoading || loading}}" bindtap="openReadingSelector">按阅读分类查找</button><button disabled="{{optionsLoading || loading}}" bindtap="openSynchronizedTextbooks">从同步教材查找</button></view></view>
    <view wx:if="{{showWeightEditor}}" class="section weight-editor"><text class="section-title">计分权重</text><text class="section-note">各内容项合计须为 100%，不填写时默认等权。</text><view wx:for="{{weightRows}}" wx:key="id" class="weight-row"><text>{{item.title}}</text><view><input type="digit" value="{{item.value}}" data-id="{{item.id}}" bindinput="onWeightInput" disabled="{{editingStatus && editingStatus !== 'draft' && editingStatus !== 'scheduled'}}"/><text>%</text></view></view><text wx:if="{{weightError}}" class="weight-error">{{weightError}}</text></view>
    <view class="section"><text class="section-title">任务名称</text><input maxlength="50" value="{{title}}" disabled="{{editingStatus && editingStatus !== 'draft' && editingStatus !== 'scheduled'}}" bindinput="onTitle" placeholder="例如：本周阅读与单词"/><text class="field-label">学生可见要求</text><textarea maxlength="300" value="{{description}}" bindinput="onDescription" placeholder="写下完成要求"></textarea><text class="field-label">教师备注</text><textarea class="teacher-note" maxlength="100" value="{{teacherNote}}" bindinput="onTeacherNote" placeholder="仅教师可见，不会展示给学生"></textarea></view>
    <view class="summary">
      <view class="summary-title"><text>发布设置</text><text>当前授权范围</text></view>
      <view class="summary-row summary-row--target"><text>发布对象</text><button class="target-trigger" disabled="{{optionsLoading || loading || requestedStudentId || (editingStatus && editingStatus !== 'draft' && editingStatus !== 'scheduled')}}" bindtap="toggleTargetEditor"><text>{{targetSummary}}</text><text>{{requestedStudentId ? '仅此学员' : targetEditorOpen ? '收起 ›' : targetCount ? '修改 ›' : '选择 ›'}}</text></button></view>
      <view wx:if="{{targetEditorOpen}}" class="target-editor">
        <view class="target-mode"><button class="{{targetMode === 'classes' ? 'active' : ''}}" data-mode="classes" bindtap="chooseTargetMode"><text>按班级</text></button><button class="{{targetMode === 'students' ? 'active' : ''}}" data-mode="students" bindtap="chooseTargetMode"><text>按学员</text></button></view>
        <input wx:if="{{targetMode === 'students'}}" class="target-search" value="{{targetKeyword}}" bindinput="onTargetSearch" placeholder="搜索姓名、学号或班级"/>
        <scroll-view scroll-y="{{true}}" class="target-options">
          <block wx:if="{{targetMode === 'classes'}}"><view wx:for="{{targetClasses}}" wx:key="id" class="target-option" data-id="{{item.id}}" bindtap="toggleTargetClass"><view class="target-check {{item.selected ? 'selected' : ''}}">{{item.selected ? '✓' : ''}}</view><view><text>{{item.name}}</text><text>{{item.grade}} {{item.term}}</text></view></view><text wx:if="{{!targetClasses.length}}" class="target-empty">暂无授权班级</text></block>
          <block wx:else><view wx:for="{{visibleTargetStudents}}" wx:key="studentId" class="target-option" data-id="{{item.studentId}}" bindtap="toggleTargetStudent"><view class="target-check {{item.selected ? 'selected' : ''}}">{{item.selected ? '✓' : ''}}</view><view><text>{{item.displayName}}　{{item.studentNumber}}</text><text>{{item.classInfo.name}}</text></view></view><text wx:if="{{!visibleTargetStudents.length}}" class="target-empty">暂无符合条件的学员</text></block>
        </scroll-view>
        <view class="target-editor-footer"><text>已选 {{targetCount}} 人</text><button bindtap="toggleTargetEditor">完成</button></view><text wx:if="{{targetCount > 500}}" class="target-over-limit">单次最多布置给 500 名学员，请取消部分选择。</text>
      </view>
      <view class="summary-row summary-row--schedule"><text>开始时间</text><view class="schedule-fields"><picker mode="date" value="{{startsDate}}" disabled="{{optionsLoading || (editingStatus && editingStatus !== 'draft' && editingStatus !== 'scheduled')}}" bindchange="onStartDate"><view class="schedule-value">{{startsDate || '选择日期'}} ›</view></picker><picker mode="time" value="{{startsTime}}" disabled="{{optionsLoading || (editingStatus && editingStatus !== 'draft' && editingStatus !== 'scheduled')}}" bindchange="onStartTime"><view class="schedule-value">{{startsTime || '选择时间'}} ›</view></picker></view></view>
      <view class="summary-row summary-row--schedule"><text>截止时间</text><view class="schedule-fields"><picker mode="date" value="{{dueDate}}" disabled="{{optionsLoading}}" bindchange="onDueDate"><view class="schedule-value">{{dueDate || '选择日期'}} ›</view></picker><picker mode="time" value="{{dueTime}}" disabled="{{optionsLoading}}" bindchange="onDueTime"><view class="schedule-value">{{dueTime || '选择时间'}} ›</view></picker></view></view>
    </view>
    <view class="preview"><text class="section-title">发布预览</text><text>{{title || '填写任务名称后在这里预览'}}</text><text>发布给：{{targetSummary}}</text><text>{{description || '学生将在任务详情中看到完成要求'}}</text></view>
    <button wx:if="{{!editingStatus || editingStatus === 'draft'}}" class="save-template-action" loading="{{loading}}" disabled="{{loading || optionsLoading}}" bindtap="saveAsTemplate">{{editingTemplate ? '保存模板修改' : '保存为模板'}}</button>
    <text wx:if="{{error}}" class="error">{{error}}</text>
  </view>
  <view wx:if="{{resumePublication}}" class="action-bar action-bar--single"><button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="resumePendingPublication">继续发布</button></view>
  <view wx:else class="action-bar {{editingStatus && editingStatus !== 'draft' ? 'action-bar--single' : ''}}"><button wx:if="{{!editingStatus || editingStatus === 'draft'}}" class="draft-action" disabled="{{loading || optionsLoading}}" bindtap="saveDraft">保存草稿</button><button class="primary" loading="{{loading || optionsLoading}}" disabled="{{optionsLoading}}" bindtap="publish">{{editingStatus && editingStatus !== 'draft' ? '预览并保存修改' : '预览并发布'}}</button></view>
</view>
