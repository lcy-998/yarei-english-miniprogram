<g0-page-shell nature="{{true}}" tone="teacher"><view class="template-page"><app-header title="任务模板" back="{{true}}" backUrl="/pages/teacher/task-center/task-center"></app-header><state-panel wx:if="{{loading}}" state="loading"></state-panel><state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadTemplates"></state-panel>
  <view wx:else class="template-content"><view class="template-hero"><text>常用任务，一键复用</text><text>模板只保存内容和要求；学生、时间与教师备注在布置时另选。</text></view>
    <view class="template-filters"><button class="{{filter === '全部' ? 'active' : ''}}" data-filter="全部" bindtap="chooseFilter">全部</button><button class="{{filter === '系统' ? 'active' : ''}}" data-filter="系统" bindtap="chooseFilter">系统</button><button class="{{filter === '我的' ? 'active' : ''}}" data-filter="我的" bindtap="chooseFilter">我的</button></view>
    <view wx:if="{{!visibleTemplates.length}}" class="template-empty">当前没有模板。可在布置任务页保存个人模板。</view>
    <view wx:for="{{visibleTemplates}}" wx:key="id" class="template-card"><view class="template-head"><text class="template-title">{{item.title}}</text><text class="template-scope">{{item.scope === 'system' ? '系统只读' : '我的模板'}}</text></view><text class="template-meta">{{item.items.length}} 项内容　使用 {{item.useCount}} 次</text><text class="template-desc">{{item.description || '暂无任务说明'}}</text>
      <view wx:if="{{editingId === item.id}}" class="rename-row"><input value="{{editTitle}}" bindinput="onTitle" maxlength="50"/><button bindtap="saveRename">保存</button><button bindtap="cancelRename">取消</button></view>
      <view class="template-actions"><button data-id="{{item.id}}" bindtap="useTemplate" loading="{{busyId === item.id}}" disabled="{{busyId !== ''}}">使用模板</button><button data-id="{{item.id}}" bindtap="copyTemplate" disabled="{{busyId !== ''}}">复制</button><button wx:if="{{item.scope === 'personal'}}" data-id="{{item.id}}" bindtap="editTemplate" disabled="{{busyId !== ''}}">编辑</button><button wx:if="{{item.scope === 'personal'}}" data-id="{{item.id}}" bindtap="startRename" disabled="{{busyId !== ''}}">重命名</button><button wx:if="{{item.scope === 'personal'}}" data-id="{{item.id}}" bindtap="removeTemplate" disabled="{{busyId !== ''}}">删除</button></view>
    </view>
  </view><g0-tab-bar role="teacher" active="tasks"></g0-tab-bar>
</view></g0-page-shell>
