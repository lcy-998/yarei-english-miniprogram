<g0-page-shell nature="{{true}}" tone="teacher"><view class="textbook-page"><app-header title="班级课本详情" back="{{true}}" backUrl="/pages/teacher/class-textbooks/class-textbooks" backIntercept="{{true}}" bind:back="onNavigateBack"></app-header><view class="textbook-content">
  <state-panel wx:if="{{loading}}" state="loading" message="正在加载班级课本"></state-panel><state-panel wx:elif="{{error && !target}}" state="error" message="{{error}}" bind:retry="load"></state-panel><view wx:else><view class="class-detail-intro"><view class="class-detail-avatar">班</view><view><text class="textbook-title">{{target.name}}</text><text class="textbook-subtitle">{{target.grade}}　{{target.term}}　{{target.studentCount}} 名学员</text></view></view><view class="textbook-card config-summary"><text class="textbook-card-title">课本配置</text><text class="textbook-card-meta">{{target.config ? target.config.status === 'published' ? '已发布' : '草稿' : '未配置'}}　当前 {{rows.length}} 本课本</text><text wx:if="{{target.config && target.config.publishedAt}}" class="textbook-card-meta">上次发布：{{target.config.publishedAt}}</text><button class="textbook-primary" bindtap="openCatalog">添加授权课本</button></view>
  <view wx:for="{{rows}}" wx:for-item="row" wx:for-index="bookIndex" wx:key="id" class="textbook-card"><view class="textbook-row"><view class="book-cover-mark"><g0-icon name="reading" size="{{38}}"></g0-icon></view><view class="textbook-row-main"><text class="textbook-card-title">{{row.title}}</text><text wx:if="{{row.book}}" class="textbook-card-meta">{{row.book.grade}}　{{row.book.term}}　{{row.book.edition}}</text><text class="book-status {{row.valid ? '' : 'invalid'}}">{{row.valid ? '当前可用' : '课本已失效或版本变更'}}</text></view><view class="textbook-reorder"><button data-index="{{bookIndex}}" data-delta="-1" bindtap="moveBook" disabled="{{bookIndex === 0}}">↑</button><button data-index="{{bookIndex}}" data-delta="1" bindtap="moveBook" disabled="{{bookIndex === rows.length - 1}}">↓</button></view></view>
    <view wx:for="{{row.chapters}}" wx:for-item="chapter" wx:for-index="chapterIndex" wx:key="id" class="chapter-row"><view class="textbook-row"><text>单元 {{chapterIndex + 1}}　{{chapter.title}}</text><view class="textbook-reorder"><button data-book="{{bookIndex}}" data-index="{{chapterIndex}}" data-delta="-1" bindtap="moveChapter" disabled="{{chapterIndex === 0}}">↑</button><button data-book="{{bookIndex}}" data-index="{{chapterIndex}}" data-delta="1" bindtap="moveChapter" disabled="{{chapterIndex === row.chapters.length - 1}}">↓</button></view></view><view wx:for="{{chapter.lessons}}" wx:for-item="lesson" wx:for-index="lessonIndex" wx:key="id" class="lesson-row textbook-row"><text>课次 {{lessonIndex + 1}}　{{lesson.title}}</text><view class="textbook-reorder"><button data-book="{{bookIndex}}" data-chapter="{{chapter.id}}" data-index="{{lessonIndex}}" data-delta="-1" bindtap="moveLesson" disabled="{{lessonIndex === 0}}">↑</button><button data-book="{{bookIndex}}" data-chapter="{{chapter.id}}" data-index="{{lessonIndex}}" data-delta="1" bindtap="moveLesson" disabled="{{lessonIndex === chapter.lessons.length - 1}}">↓</button></view></view></view>
    <view class="textbook-card-actions"><button data-id="{{row.item.textbookId}}" bindtap="previewBook" disabled="{{!row.valid}}">预览</button><button data-id="{{row.item.textbookId}}" bindtap="useForTask" disabled="{{!row.valid}}">布置任务</button><button data-id="{{row.item.textbookId}}" bindtap="removeBook">移除课本</button></view>
  </view><view wx:if="{{!rows.length}}" class="textbook-card textbook-empty">此班级尚无课本，可从授权同步学教材中添加。</view><view class="textbook-card"><text class="textbook-card-title">发布备注</text><input class="textbook-input" placeholder="选填，最多 100 字" maxlength="100" value="{{note}}" bindinput="onNote"/></view><text wx:if="{{error}}" class="textbook-error">{{error}}</text></view>
  </view><view wx:if="{{target}}" class="textbook-footer"><button class="secondary" bindtap="undo" disabled="{{!dirty || saving}}">撤销</button><button class="secondary" bindtap="saveDraft" loading="{{saving}}" disabled="{{saving}}">保存草稿</button><button class="primary" bindtap="publish" disabled="{{saving || !rows.length}}">发布</button></view></view></g0-page-shell>
