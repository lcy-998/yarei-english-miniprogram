<g0-page-shell tone="teacher">
  <view class="quick-review-page">
    <app-header title="快速点评" back="{{true}}"></app-header>
    <state-panel wx:if="{{loading}}" state="loading"></state-panel>
    <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadRows"></state-panel>
    <view wx:else class="quick-review-content">
      <view class="review-summary"><view class="summary-icon">评</view><view class="summary-copy"><text>待点评</text><text class="summary-count">{{baseRows.length}}</text></view><text class="summary-divider"></text><text class="summary-position">第 {{activeRowIndex + 1}}/{{baseRows.length || 1}} 条</text><button class="skip-button" bindtap="skipCurrent">跳过</button></view>
      <view class="class-preview"><view class="section-heading"><text>分班预览</text><text class="section-note">仅查看当前教师授权班级</text></view><scroll-view scroll-x="{{true}}" class="class-tabs"><view wx:for="{{classOptions}}" wx:key="id" class="class-tab {{classPreview === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectClassPreview"><text>{{item.label}}</text><text>{{item.count}} 条</text></view></scroll-view></view>
      <view wx:if="{{activeRow}}" class="student-summary"><view class="student-avatar">{{activeRow.studentName}}</view><view class="student-copy"><text class="student-name">{{activeRow.studentName}} · {{activeRow.className}}</text><text class="task-name">英语综合练习</text><text class="submitted-at">提交时间 9 月 13 日 18:35</text></view><view class="system-score"><text>系统得分</text><text>{{activeRow.score || 86}}</text></view></view>
      <view wx:elif="{{visibleRows.length === 0}}" class="empty-review">该班级暂无待点评提交，可切换其他班级预览。</view>
      <view wx:if="{{activeRow}}" class="submission-card"><view class="section-heading"><text>提交内容</text><text class="view-detail">查看详情 ›</text></view><view class="submission-items"><view><view class="submission-icon submission-icon--reading">阅</view><text>阅读</text><text class="success-text">已完成</text></view><view><view class="submission-icon submission-icon--word">A</view><text>单词</text><text class="score-text">88 分</text></view><view><view class="submission-icon submission-icon--exercise">题</view><text>习题</text><text class="score-text">84 分</text></view></view></view>
      <view wx:if="{{activeRow}}" class="feedback-card">
        <view class="feedback-block"><view class="heading-with-icon"><view class="heading-icon heading-icon--text">文</view><text>文字点评</text></view><textarea maxlength="200" value="{{comment}}" bindinput="onComment" placeholder="写下对学生的鼓励和建议"></textarea><text class="char-count">{{comment.length}}/200</text></view>
        <view class="feedback-block"><view class="heading-with-icon"><view class="heading-icon heading-icon--voice">语</view><text>语音点评</text></view><button class="voice-box {{voiceRecorded ? 'recorded' : ''}}" bindtap="toggleVoice"><view class="voice-icon">语</view><text>{{voiceRecorded ? '已录制 · 00:12' : '点击录制语音点评'}}</text></button></view>
        <view class="feedback-block score-block"><view class="heading-with-icon"><view class="heading-icon heading-icon--score">分</view><text>评分</text></view><view class="score-picker"><view wx:for="{{starValues}}" wx:key="*this" class="star {{item * 20 <= score ? 'active' : ''}}" data-score="{{item * 20}}" bindtap="setScore">★</view><text>{{score / 20}} 分</text></view></view>
      </view>
      <view wx:if="{{activeRow}}" class="review-actions"><button class="return-button" data-row="{{activeRow}}" bindtap="returned">退回重做</button><button class="publish-button" data-row="{{activeRow}}" bindtap="approve">发布并进入下一条</button></view>
      <view wx:if="{{baseRows.length > 1}}" class="queue-list"><text class="queue-title">待点评队列</text><view wx:for="{{visibleRows}}" wx:key="assignmentId" class="queue-row {{item.assignmentId === activeRowId ? 'active' : ''}}" data-index="{{index}}" bindtap="selectRow"><text>{{item.studentName}}</text><text>{{item.status === 'awaiting_review' ? '待点评' : item.status === 'completed' ? '已完成' : '未提交'}}</text></view></view>
    </view>
  </view>
</g0-page-shell>
