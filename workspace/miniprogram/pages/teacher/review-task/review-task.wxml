<view class="page page--secondary">
  <image class="page-bg" src="/assets/g0/student-public-natural-background-v1.jpg" mode="scaleToFill" aria-hidden="true"></image>
  <app-header title="检查任务" back="{{true}}"></app-header>
  <state-panel wx:if="{{loading}}" state="loading"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadRows"></state-panel>
  <view wx:else class="content"><view class="editor"><text>本次点评</text><input type="number" value="{{score}}" bindinput="onScore"/><textarea value="{{comment}}" bindinput="onComment"></textarea></view><view wx:for="{{rows}}" wx:key="assignmentId" class="row"><view><text class="name">{{item.studentName}}</text><text class="status">{{item.status}}</text></view><view wx:if="{{item.submissionId}}" class="buttons"><view class="review-action return" data-row="{{item}}" bindtap="returned" aria-role="button">{{reviewingId === item.assignmentId ? '处理中…' : '退回'}}</view><view class="review-action approve" data-row="{{item}}" bindtap="approve" aria-role="button">{{reviewingId === item.assignmentId ? '处理中…' : '通过并点评'}}</view></view><text wx:else class="empty">尚未提交</text></view></view>
</view>
