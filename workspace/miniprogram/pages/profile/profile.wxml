<g0-page-shell nature="{{true}}" tone="{{profile.role === 'teacher' ? 'teacher' : profile.role === 'parent' ? 'parent' : 'nature'}}"><view class="m1-page"><app-header title="我的"></app-header><state-panel wx:if="{{loading}}" state="loading"></state-panel><state-panel wx:elif="{{error && !profile}}" state="error" message="{{error}}" bind:retry="loadProfile"></state-panel><view wx:elif="{{profile}}" class="m1-content"><view class="m1-card profile-card"><view class="m1-avatar">{{profile.displayName}}</view><view class="profile-copy"><text class="profile-name">{{profile.displayName}}</text><text>{{profile.maskedMobile}}</text><text>{{profile.roleLabel}} · {{profile.className || profile.organization}}</text></view><button class="edit-button" bindtap="toggleEdit">{{editing ? '取消' : '编辑资料'}}</button></view><view wx:if="{{editing}}" class="m1-card"><text class="m1-section-title">编辑资料</text><input class="m1-input" maxlength="20" value="{{displayName}}" bindinput="onName"/><text wx:if="{{error}}" class="m1-inline-error">{{error}}</text><view class="m1-actions"><g0-button loading="{{saving}}" bind:action="save">保存资料</g0-button></view></view><view wx:if="{{profile.role === 'student'}}" class="m1-card"><text class="m1-section-title">学习记录</text><view class="m1-row" bindtap="openTasks"><view class="m1-row-copy"><text class="m1-row-title">我的任务</text></view><view class="m1-chevron"></view></view><view class="m1-row" bindtap="openReading"><view class="m1-row-copy"><text class="m1-row-title">阅读收藏</text></view><view class="m1-chevron"></view></view><view class="m1-row" bindtap="openWords"><view class="m1-row-copy"><text class="m1-row-title">单词学习记录</text></view><view class="m1-chevron"></view></view></view><view class="m1-card"><text class="m1-section-title">账号设置</text><view class="m1-row" bindtap="openPassword"><view class="m1-row-copy"><text class="m1-row-title">修改密码</text></view><view class="m1-chevron"></view></view><view class="m1-row" bindtap="switchRole"><view class="m1-row-copy"><text class="m1-row-title">切换身份</text></view><view class="m1-chevron"></view></view></view><button class="logout" bindtap="logout">退出登录</button></view><g0-tab-bar wx:if="{{profile}}" role="{{profile.role}}" active="mine"></g0-tab-bar></view></g0-page-shell>


