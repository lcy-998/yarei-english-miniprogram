<g0-page-shell nature="{{true}}" natureOpacity="{{0.68}}" tone="nature">
  <view class="video-task-page">
    <app-header title="{{teacherReview ? '视频作业验收' : teacherPreview ? '视频预览' : kind === 'dubbing' ? '配音示范' : '视频任务'}}" back="{{true}}"></app-header>
    <state-panel wx:if="{{loading}}" state="loading"></state-panel>
    <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="load"></state-panel>
    <view wx:else class="video-task-content">
      <view class="video-hero"><view><text class="video-eyebrow">{{kind === 'dubbing' ? '先观看 · 再配音' : '课堂视频 · 按顺序观看'}}</text><text class="video-title">{{itemTitle}}</text><text class="video-description">{{teacherReview ? '教师只读查看 · 第 ' + teacherReviewVersion + ' 次提交' : teacherPreview ? '按学员作答页面查看视频与题目；预览不保存播放或答案。' : kind === 'dubbing' ? '完整观看示范视频后，返回配音页录制作品。' : '观看视频并完成下方题目，答案会保存在本机。'}}</text></view><view class="video-art"><image src="/assets/icons/play.svg" mode="aspectFit" aria-hidden="true"></image></view></view>
      <view class="video-card"><view class="video-heading"><view><text class="video-kicker">WATCH &amp; LEARN</text><text class="video-heading-title">观看视频</text></view><text class="video-count">{{kind === 'video' ? questions.length + ' 道题' : '配音示范'}}</text></view>
        <view wx:if="{{playback.temporaryUrl}}" class="video-stage"><video id="task-video" class="task-video" src="{{playback.temporaryUrl}}" controls="{{false}}" autoplay="{{false}}" show-center-play-btn="{{false}}" show-fullscreen-btn="{{false}}" bindtimeupdate="onVideoTimeUpdate" bindplay="onVideoPlay" bindpause="onVideoPause" bindwaiting="onVideoWaiting" binderror="onVideoError" bindended="onVideoEnded"></video></view><text wx:else class="video-warning">原视频当前不可播放，提交答案仍可核对。</text>
        <view wx:if="{{subtitle}}" class="subtitle" bindtap="toggleSubtitleLanguage" aria-role="button" aria-label="切换视频字幕语言">
          <text>{{subtitle}}<text wx:if="{{subtitleInChinese}}">{{subtitleTranslation || '中文译文暂未提供'}}</text></text>
          
        </view>
        <media-player title="任务视频" playing="{{playing}}" progress="{{positionPercent}}" currentTime="{{currentLabel}}" duration="{{durationLabel}}" speed="{{speed}}×" locked="{{!teacherPreview}}" seekLimit="{{teacherPreview ? 100 : confirmedPercent}}" showEarModeToggle="{{false}}" state="{{playbackError ? 'error' : buffering ? 'loading' : 'ready'}}" bare="{{true}}" bind:toggle="togglePlayback" bind:speed="chooseSpeed" bind:seek="seek" bind:seekblocked="blockSeek" bind:retry="retry"></media-player>
        <text class="video-note">{{teacherReview ? teacherReviewProgress + '；教师播放不计入学员进度' : teacherPreview ? '教师只读试听 · 可自由定位，不计入学员进度' : '已确认播放 ' + confirmedPercent + '% · 可暂停、调速和向后回看'}}</text>
        <text wx:if="{{completed}}" class="video-success">{{teacherReview ? '已试听完整段视频；本次播放不改变学生提交。' : teacherPreview ? '已看完整段视频；教师预览不会记录完成进度。' : kind === 'dubbing' ? '示范视频已完整观看，可以返回配音页录制。' : '观看要求已达到，请完成题目后返回任务详情提交。'}}</text>
        <text wx:if="{{warning}}" class="video-warning">{{warning}}</text>
        <view wx:if="{{playbackError}}" class="video-error"><text>{{playbackError}}</text><button bindtap="retry">重试播放</button></view>
      </view>
      <view wx:if="{{kind === 'video' && questions.length}}" class="question-section"><view class="questions-heading"><text>视频题目</text><text>{{teacherReview ? '当前提交的原作答与判定' : '边看边答，作答会自动保留'}}</text></view>
        <view wx:for="{{questions}}" wx:for-item="question" wx:key="questionId" class="video-card question-card"><view class="question-head"><text class="question-number">{{index + 1}}</text><text class="question-stem">{{question.stem}}</text></view><text wx:if="{{question.questionType === 'multiple_choice'}}" class="answer-hint">可选择多个答案</text><view wx:if="{{question.options.length}}" class="options"><button wx:for="{{question.options}}" wx:for-item="choice" wx:key="value" class="option {{choice.selected ? 'option--selected' : ''}} {{teacherReview && choice.selected ? (question.verdict === '正确' ? 'review-correct' : question.verdict === '错误' ? 'review-wrong' : '') : ''}}" data-question-id="{{question.questionId}}" data-value="{{choice.value}}" disabled="{{teacherPreview}}" bindtap="chooseOption"><text class="option-dot">{{choice.selected ? '✓' : ''}}</text><text>{{choice.value}}</text></button></view><textarea wx:else class="answer-input" disabled="{{teacherPreview}}" value="{{question.answerText}}" data-question-id="{{question.questionId}}" bindinput="inputAnswer" maxlength="500" placeholder="请输入你的答案"></textarea><view wx:if="{{teacherReview}}" class="review-evidence"><text>学生答案：{{question.responseLabel}}</text><text>正确答案：{{question.correctLabel}}</text><text class="{{question.verdict === '正确' ? 'review-verdict-correct' : question.verdict === '错误' ? 'review-verdict-wrong' : ''}}">{{question.verdict}}</text><text wx:if="{{question.explanation}}">解析：{{question.explanation}}</text></view><view wx:if="{{teacherReview && question.teacherScoreRequired}}" class="review-question-score"><text>本题教师评分</text><view class="review-score"><input type="number" maxlength="3" value="{{question.teacherScoreInput}}" data-question-id="{{question.questionId}}" bindinput="onTeacherQuestionScore" placeholder="0—100"/><text>分</text></view><text wx:if="{{question.teacherScoreError}}" class="video-warning">{{question.teacherScoreError}}</text></view></view>
        <text wx:if="{{draftError}}" class="video-error">{{draftError}}</text>
      </view>
      <view wx:if="{{teacherReview && teacherScoreRequired}}" class="video-card question-card"><text class="question-stem">视频题目合计</text><text>{{teacherItemScorePreview === null ? '请完成上方主观题评分' : teacherItemScorePreview + ' 分（含客观题自动分）'}}</text><text>返回快速点评后计入作业总分。</text></view>
      <task-return-bar label="{{teacherReview ? '返回快速点评' : teacherPreview ? '返回内容选择' : kind === 'dubbing' ? '返回配音页' : '提交并返回任务详情'}}" bind:press="returnToTask"></task-return-bar>
    </view>
  </view>
</g0-page-shell>
