<g0-page-shell nature="{{true}}" natureOpacity="{{0.68}}" tone="nature"><view class="dubbing-page {{taskMode || teacherReviewMode ? 'dubbing-page--task-mode' : ''}}">
  <app-header title="视频配音" back="{{true}}"></app-header>
  <state-panel wx:if="{{loading}}" state="loading"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadMaterials"></state-panel>
  <view wx:elif="{{teacherPreviewMode && teacherPreviewAsset}}" class="dubbing-content">
    <view class="dubbing-hero"><text class="dubbing-title">给故事配上你的声音</text><text class="dubbing-subtitle">教师内容预览 · 学生视频配音界面</text></view>
    <view class="dubbing-card"><text class="dubbing-section-title">任务配音 · {{teacherPreviewAsset.title}}</text><text class="dubbing-subtitle">预览示范视频与字幕，不记录播放进度或录音。</text><video id="teacher-preview-dubbing-video" class="demonstration-video" src="{{teacherPreviewAsset.playback.temporaryUrl}}" controls="{{false}}" autoplay="{{false}}" show-center-play-btn="{{false}}" bindtimeupdate="onTeacherPreviewVideoTimeUpdate" bindpause="onTeacherPreviewVideoPause" bindended="onTeacherPreviewVideoPause" binderror="onTeacherPreviewVideoError"></video><view wx:if="{{teacherPreviewSubtitle}}" class="task-subtitle-card" bindtap="toggleSubtitleLanguage"><text class="task-subtitle-text">{{teacherPreviewSubtitle}}<text wx:if="{{subtitleInChinese}}">{{teacherPreviewSubtitleTranslation || '中文译文暂未提供'}}</text></text></view><view class="record-actions"><button bindtap="toggleTeacherPreviewVideo">{{teacherPreviewPlaying ? '暂停示范' : '播放示范'}}</button><button bindtap="replayTeacherPreviewVideo">从头重听</button></view></view>
    <view class="dubbing-card"><text class="dubbing-section-title">录制任务配音</text><button class="submit-work" disabled="{{true}}">开始录音</button><text class="dubbing-subtitle">教师预览不使用麦克风，也不创建学生作品。</text></view>
    <button class="my-works-link" bindtap="refreshTeacherAssetPreview">刷新预览地址</button>
  </view>
  <view wx:elif="{{teacherReviewMode && teacherEvidence}}" class="dubbing-content">
    <view class="dubbing-hero"><text class="dubbing-title">给故事配上你的声音</text><text class="dubbing-subtitle">教师只读查看 · 第 {{teacherEvidence.submissionVersion}} 次提交</text></view>
    <view class="dubbing-card"><text class="dubbing-section-title">任务配音 · {{teacherEvidence.title}}</text><text class="dubbing-subtitle">教师试听不会写入学生播放进度。</text><view wx:if="{{teacherEvidence.sourcePlayback.available && teacherEvidence.sourcePlayback.temporaryUrl}}" class="task-demonstration-stage"><video id="teacher-demonstration-video" class="demonstration-video" src="{{teacherEvidence.sourcePlayback.temporaryUrl}}" controls="{{true}}" autoplay="{{false}}" bindtimeupdate="onTeacherVideoTimeUpdate"></video></view><text wx:else class="material-unavailable">示范视频暂不可试听</text><view wx:if="{{teacherSubtitle}}" class="task-subtitle-card" bindtap="toggleSubtitleLanguage"><text class="task-subtitle-text">{{teacherSubtitle}}<text wx:if="{{subtitleInChinese}}">{{teacherSubtitleTranslation || '中文译文暂未提供'}}</text></text></view><view class="task-playback-controls"><text class="video-note">{{teacherEvidence.verifiedRanges.length ? '已记录示范视频观看证据' : '本次提交未记录示范视频观看范围'}}</text><button class="material-more" bindtap="refreshTeacherDubbingReview">刷新授权试听地址</button></view></view>
    <view class="dubbing-card"><text class="dubbing-section-title">录制任务配音</text><view class="recording-status"><text>{{teacherEvidence.finalWork ? '学生录音已提交' : '未记录最终配音'}}</text><text>{{teacherFinalDurationLabel}}</text></view><view class="record-actions task-record-actions"><button wx:if="{{teacherEvidence.finalWork && teacherEvidence.finalWork.available}}" bindtap="playTeacherFinalWork">{{teacherFinalPlaying ? '停止试听' : '试听学生配音'}}</button><text wx:else class="material-unavailable">本次提交暂无可试听的配音录音</text></view></view>
    <view class="dubbing-card"><text class="dubbing-section-title">本项评分草稿</text><view class="teacher-score-row"><input type="number" maxlength="3" value="{{teacherScoreInput}}" bindinput="onTeacherReviewScore" placeholder="0—100"/><text>分</text></view><text wx:if="{{teacherScoreError}}" class="recording-issue">{{teacherScoreError}}</text><text class="dubbing-subtitle">返回快速点评后核对总分；正式发布前仍可修改。</text></view>
    <task-return-bar label="返回快速点评" bind:press="returnToTeacherReview"></task-return-bar>
  </view>
  <view wx:else class="dubbing-content">
    <view class="dubbing-hero"><text class="dubbing-title">给故事配上你的声音</text><text class="dubbing-subtitle">选择素材、录制并试听，满意后再提交作品。</text></view>
    <view wx:if="{{!taskMode && !hasAuthorizedMaterials && !localPath}}" class="dubbing-card">暂无已授权的配音素材</view>
    <block wx:else>
      <view wx:if="{{taskMode}}" class="dubbing-card">
        <view class="dubbing-section-row"><text class="dubbing-section-title">任务配音 · {{taskTitle}}</text><button class="speed-button" bindtap="cycleSpeed">{{demonstrationSpeed}} 倍速</button></view>
        <text class="dubbing-subtitle">{{taskPlaybackReady ? '示范已完整观看，可以录制并封存配音；正式提交仍在任务详情完成。' : '先在此顺序观看示范视频，看完后即可在本页录音。'}}</text>
        <view wx:if="{{demonstrationUrl}}" class="task-demonstration-stage"><video id="demonstration" class="demonstration-video {{taskEarMode ? 'demonstration-video--hidden' : ''}}" src="{{demonstrationUrl}}" controls="{{false}}" autoplay="{{false}}" show-center-play-btn="{{false}}" show-fullscreen-btn="{{false}}" bindplay="onTaskDemonstrationPlay" bindpause="onTaskDemonstrationPause" bindwaiting="onTaskDemonstrationWaiting" bindended="onTaskDemonstrationEnded" binderror="onTaskDemonstrationError" bindtimeupdate="onTaskVideoTimeUpdate"></video><view wx:if="{{taskEarMode}}" class="task-ear-overlay"><text>文字与画面已隐藏</text></view></view>
        <view wx:else class="material-unavailable">示范视频暂不可播放，请点击重试</view>
        <view wx:if="{{!taskEarMode && taskSubtitle}}" class="task-subtitle-card" bindtap="toggleSubtitleLanguage"><text class="task-subtitle-text">{{taskSubtitle}}<text wx:if="{{subtitleInChinese}}">{{taskSubtitleTranslation || '中文译文暂未提供'}}</text></text></view>
        <view class="task-playback-controls">
        <media-player title="配音示范" playing="{{taskVideoPlaying}}" progress="{{taskVideoPositionPercent}}" currentTime="{{taskVideoCurrentLabel}}" duration="{{taskVideoDurationLabel}}" speed="{{demonstrationSpeed}}×" locked="{{true}}" seekLimit="{{taskVideoConfirmedPercent}}" earMode="{{taskEarMode}}" state="{{taskVideoPlaybackError ? 'error' : taskVideoBuffering ? 'loading' : 'ready'}}" bare="{{true}}" bind:toggle="toggleTaskDemonstration" bind:speed="cycleSpeed" bind:earmode="toggleTaskEarMode" bind:seek="seekTaskDemonstration" bind:seekblocked="blockTaskSeek" bind:retry="retryTaskVideo"></media-player>
        <text class="video-note">已确认观看 {{taskVideoConfirmedPercent}}% · 可暂停、调速和向后回看</text>
        <text wx:if="{{taskPlaybackReady}}" class="video-success">示范视频已完整观看，可以开始录音。</text>
        <text wx:if="{{taskVideoWarning}}" class="video-warning">{{taskVideoWarning}}</text>
        <view wx:if="{{taskVideoPlaybackError}}" class="video-error"><text>{{taskVideoPlaybackError}}</text><button bindtap="retryTaskVideo">重试播放</button></view>
        </view>
      </view>
      <view wx:else class="dubbing-card"><view class="material-heading"><view class="material-current"><text class="dubbing-section-title">当前素材</text><text class="material-current-title">{{selectedMaterial ? selectedMaterial.title : '尚未选择素材'}}</text><text wx:if="{{selectedMaterial}}" class="material-current-meta">{{selectedMaterial.grade || '未标注年级'}}　{{selectedMaterial.textbook || '未标注教材'}}　{{selectedMaterial.unit || '未标注单元'}}</text></view><button class="material-switch" bindtap="toggleMaterialSelect">{{materialSelectOpen ? '收起选择' : '选择素材'}}</button></view><text wx:if="{{!hasAuthorizedMaterials}}" class="dubbing-subtitle">当前没有可用素材，录音草稿仍保留在本次使用中。</text>
        <view wx:if="{{materialSelectOpen}}" class="material-selector"><input class="material-search" value="{{materialKeyword}}" bindinput="onMaterialSearch" maxlength="80" placeholder="搜索素材名称或字幕"/>
          <view class="material-filter-row">
            <view class="material-filter {{gradeFilter !== '全部年级' || materialFilterOpen === 'grade' ? 'material-filter--active' : ''}}"><button data-key="grade" bindtap="toggleMaterialFilter" aria-label="筛选年级，当前{{gradeFilter}}"><text class="material-filter-label">{{gradeFilter}}</text><text class="material-filter-caret">▾</text></button><view wx:if="{{materialFilterOpen === 'grade'}}" class="material-filter-menu"><view data-key="grade" data-value="全部年级" bindtap="chooseMaterialFilter">全部年级</view><view wx:for="{{materialFilterOptions.grades}}" wx:key="*this" data-key="grade" data-value="{{item}}" bindtap="chooseMaterialFilter">{{item}}</view></view></view>
            <view class="material-filter {{textbookFilter !== '全部教材' || materialFilterOpen === 'textbook' ? 'material-filter--active' : ''}}"><button data-key="textbook" bindtap="toggleMaterialFilter" aria-label="筛选教材，当前{{textbookFilter}}"><text class="material-filter-label">{{textbookFilter}}</text><text class="material-filter-caret">▾</text></button><view wx:if="{{materialFilterOpen === 'textbook'}}" class="material-filter-menu"><view data-key="textbook" data-value="全部教材" bindtap="chooseMaterialFilter">全部教材</view><view wx:for="{{materialFilterOptions.textbooks}}" wx:key="*this" data-key="textbook" data-value="{{item}}" bindtap="chooseMaterialFilter">{{item}}</view></view></view>
            <view class="material-filter {{unitFilter !== '全部单元' || materialFilterOpen === 'unit' ? 'material-filter--active' : ''}}"><button data-key="unit" bindtap="toggleMaterialFilter" aria-label="筛选单元，当前{{unitFilter}}"><text class="material-filter-label">{{unitFilter}}</text><text class="material-filter-caret">▾</text></button><view wx:if="{{materialFilterOpen === 'unit'}}" class="material-filter-menu"><view data-key="unit" data-value="全部单元" bindtap="chooseMaterialFilter">全部单元</view><view wx:for="{{materialFilterOptions.units}}" wx:key="*this" data-key="unit" data-value="{{item}}" bindtap="chooseMaterialFilter">{{item}}</view></view></view>
          </view>
          <view class="material-results-head"><text>找到 {{materialTotal}} 个素材</text><button bindtap="clearMaterialSearch">清除筛选</button></view>
          <scroll-view scroll-y="{{true}}" class="material-options" style="height: {{materials.length > 3 ? 280 : materials.length * 88 + 62}}px">
            <view wx:for="{{materials}}" wx:key="id" class="material-option-row"><button class="material-option {{selectedMaterialId === item.id && selectedMaterial ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectMaterial"><text class="material-option-title">{{item.title}}</text><text class="material-option-meta">{{item.grade || '未标注年级'}}　{{item.textbook || '未标注教材'}}　{{item.unit || '未标注单元'}}</text><text class="material-option-subtitle">{{item.subtitle}}</text></button></view>
            <text wx:if="{{!materials.length && !materialSearchLoading}}" class="material-empty">当前条件下暂无素材，可调整筛选。</text>
            <text wx:if="{{materialSearchLoading}}" class="material-empty">正在查找素材…</text>
            <text wx:if="{{materialSearchError}}" class="material-empty">{{materialSearchError}}</text>
            <view wx:if="{{materialNextOffset !== null}}" class="material-more-row"><button class="material-more" bindtap="loadMoreMaterials" loading="{{materialSearchLoading}}" disabled="{{materialSearchLoading}}">加载更多</button></view>
          </scroll-view></view>
      </view>
      <view wx:if="{{selectedMaterial}}" class="dubbing-card"><view class="dubbing-section-row"><text class="dubbing-section-title">示范素材</text><button class="speed-button" bindtap="cycleSpeed">{{demonstrationSpeed}} 倍速</button></view>
        <video wx:if="{{demonstrationUrl}}" id="demonstration" class="demonstration-video" src="{{demonstrationUrl}}" controls="{{true}}" autoplay="{{false}}" show-center-play-btn="{{true}}" bindplay="onDemonstrationPlay" bindtimeupdate="onPracticeVideoTimeUpdate" bindended="onPracticeVideoEnded"></video>
        <view wx:else class="material-unavailable">示范视频暂不可播放，请稍后重试</view>
        <text wx:if="{{videoSpeedNotice}}" class="speed-notice">{{videoSpeedNotice}}</text>
        <view class="practice-subtitle-head"><text>当前文本</text><text wx:if="{{practiceSubtitleCues.length > 1 && practiceSubtitleIndex >= 0}}">{{practiceSubtitleIndex + 1}} / {{practiceSubtitleCues.length}}</text></view>
        <view class="task-subtitle-card practice-subtitle-card" bindtap="toggleSubtitleLanguage"><text class="task-subtitle-text {{practiceSubtitleText ? '' : 'practice-subtitle-empty'}}">{{practiceSubtitleText ? (subtitleInChinese ? (practiceSubtitleTranslation || '中文译文暂未提供') : practiceSubtitleText) : (practiceSubtitleCues.length ? '当前片段暂无台词' : '该素材暂无可信的逐句时间信息，无法同步显示台词')}}</text></view>
        <text wx:if="{{!practiceSubtitleCues.length && selectedMaterial.subtitle}}" class="practice-full-transcript">完整台词（未按视频进度同步）：{{selectedMaterial.subtitle}}</text>
        <view wx:if="{{demonstrationUrl && practiceSubtitleCues.length > 1}}" class="practice-subtitle-actions"><button disabled="{{practicePreviousCueIndex < 0}}" bindtap="showPreviousPracticeText">上一句</button><button disabled="{{practiceNextCueIndex < 0}}" bindtap="showNextPracticeText">下一句</button></view>
      </view>
      <view class="dubbing-card"><text class="dubbing-section-title">{{taskMode ? '录制任务配音' : '录制配音'}}</text>
        <view class="recording-status {{recordingState === 'recording' ? 'is-recording' : recordingIssue ? 'is-invalid' : ''}}"><text>{{recordingState === 'recording' ? '正在录音' : recordingState === 'uploading' ? '正在上传并核验' : recordingState === 'submitted' ? (taskMode ? '录音已上传，作业未提交' : '作品已提交') : recordingIssue ? '录音不可提交' : localPath ? '录音已保留在本机' : '等待录音'}}</text><text>{{durationLabel}}</text></view>
        <text wx:if="{{recordingIssue}}" class="recording-issue">{{recordingIssue}}</text>
        <view wx:if="{{submitError}}" class="submit-retry"><image src="/subpackages/student-media/assets/g0/recording-ai-retry-thumb-v1.png" mode="aspectFit" aria-hidden="true"></image><text class="submit-error">{{submitError}}</text></view>
        <view wx:if="{{taskMode}}" class="record-actions task-record-actions"><button wx:if="{{recordingState === 'recording'}}" class="recording-active" bindtap="stopRecording">结束录音</button><button wx:elif="{{recordingState === 'idle' && !localPath && (!taskWork || taskWork.status !== 'submitted')}}" class="recording-primary" disabled="{{!taskPlaybackReady}}" bindtap="startRecording">开始录音</button><button wx:if="{{recordingState === 'local' && localPath}}" bindtap="playRecording">试听本机录音</button><button wx:if="{{recordingState === 'submitted' && taskWork && taskWork.status === 'submitted'}}" bindtap="playSubmittedTaskRecording">试听已上传录音</button><button wx:if="{{recordingState === 'local' && localPath && !recordingIssue}}" class="recording-primary" disabled="{{submitting || !taskPlaybackReady || !taskWork}}" loading="{{submitting}}" bindtap="submitRecording">{{taskStagingFileId ? '重试上传' : '上传录音'}}</button><button wx:if="{{(localPath || (taskWork && taskWork.status === 'submitted')) && !submitting}}" class="{{recordingState === 'submitted' ? '' : 'recording-redo--wide'}}" bindtap="redoRecording">重录</button></view>
        <view wx:else class="record-actions"><button wx:if="{{recordingState === 'recording'}}" class="recording-active" bindtap="stopRecording">结束录音</button><button wx:elif="{{!localPath}}" disabled="{{!selectedMaterial}}" bindtap="startRecording">开始录音</button><button wx:elif="{{localPath && !recordingIssue}}" bindtap="playRecording">试听录音</button><button wx:if="{{localPath && !submitting}}" bindtap="redoRecording">重录</button></view>
        <button wx:if="{{permissionDenied}}" class="material-more" bindtap="openMicrophoneSettings">打开麦克风设置</button>
        <textarea wx:if="{{!taskMode}}" class="work-note" maxlength="200" value="{{note}}" bindinput="onNote" placeholder="给作品写一句话（选填）"></textarea>
        <button wx:if="{{!taskMode}}" class="submit-work" disabled="{{!localPath || !selectedMaterial || !!recordingIssue || submitting || recordingState === 'submitted'}}" loading="{{submitting}}" bindtap="submitRecording">提交作品</button>
      </view>
    </block>
    <task-return-bar wx:if="{{taskMode}}" label="提交并返回任务详情" bind:press="returnToTask"></task-return-bar><button wx:else class="my-works-link" bindtap="openMyWorks">查看我的作品 ›</button>
  </view>
</view></g0-page-shell>
