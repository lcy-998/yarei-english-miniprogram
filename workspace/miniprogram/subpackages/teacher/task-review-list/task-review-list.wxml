<g0-page-shell nature="{{true}}" tone="teacher">
  <view class="task-review-page" bindtap="closeMenus">
    <view class="task-review-background" aria-hidden="true"></view>
    <view class="task-review-foreground">
    <app-header title="检查任务" showBell="{{true}}"></app-header>
    <view class="teacher-brand"><image src="/assets/g0/brand-logo.png" mode="aspectFit"></image><view><text>雅睿英语</text><text>教师工作台</text></view></view>
    <state-panel wx:if="{{loading}}" state="loading"></state-panel>
    <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadTasks"></state-panel>
    <view wx:else class="task-review-content">
      <view class="page-title-row"><text class="page-title">检查任务</text><view class="class-preview">当前授权 {{total}} 项</view></view>
      <view class="filters">
        <view class="filter-control"><button data-key="type" bindtap="toggleFilter">{{typeFilter}}<text class="filter-arrow"></text></button><view wx:if="{{filterOpen === 'type'}}" class="filter-menu"><view wx:for="{{typeOptions}}" wx:key="*this" data-key="type" data-value="{{item}}" bindtap="chooseFilter">{{item}}</view></view></view>
        <view class="filter-control"><button data-key="class" bindtap="toggleFilter">{{classFilter}}<text class="filter-arrow"></text></button><view wx:if="{{filterOpen === 'class'}}" class="filter-menu"><view wx:for="{{classOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseClass">{{item.name}}</view></view></view>
        <view class="filter-control"><button data-key="status" bindtap="toggleFilter">{{statusFilter}}<text class="filter-arrow"></text></button><view wx:if="{{filterOpen === 'status'}}" class="filter-menu"><view wx:for="{{statusOptions}}" wx:key="value" data-key="status" data-value="{{item.label}}" bindtap="chooseFilter">{{item.label}}</view></view></view>
        <view class="filter-control"><button data-key="date" bindtap="toggleFilter">{{dateFilter}}<text class="filter-arrow"></text></button><view wx:if="{{filterOpen === 'date'}}" class="filter-menu"><view wx:for="{{dateOptions}}" wx:key="*this" data-key="date" data-value="{{item}}" bindtap="chooseFilter">{{item}}</view></view></view>
        <input class="task-search" value="{{keyword}}" bindinput="onSearch" placeholder="搜索任务"/>
      </view>
      <view wx:for="{{rows}}" wx:key="id" class="task-card" data-id="{{item.id}}" bindtap="openReview" aria-role="button" aria-label="查看{{item.title}}完成情况">
        <view class="task-card-head">
          <g0-icon name="task" size="56"></g0-icon>
          <view class="task-copy"><text class="task-title">{{item.title}}</text></view>
          <button class="more-button" data-id="{{item.id}}" catchtap="toggleMenu">更多</button>
          <view class="task-info"><view class="tag-row"><text class="tag tag--blue">{{item.typeLabel}}</text><text class="tag tag--green">{{item.statusLabel}}</text></view><text class="task-meta">截止 {{item.dueLabel}}</text></view>
          <view wx:if="{{item.menuOpen}}" class="more-menu"><block wx:if="{{item.kind === 'checkin'}}"><view data-id="{{item.id}}" data-action="review" catchtap="moreAction">查看活动记录</view><view wx:if="{{item.canDeleteDraft}}" class="danger" data-id="{{item.id}}" data-action="deleteActivityDraft" catchtap="moreAction">彻底删除草稿</view><view wx:if="{{item.status === 'closed'}}" class="danger" data-id="{{item.id}}" data-action="recycle" catchtap="moreAction">回收已关闭活动</view></block><block wx:else><view wx:if="{{item.status !== 'draft'}}" data-id="{{item.id}}" data-action="review" catchtap="moreAction">检查/点评</view><view wx:if="{{item.status !== 'withdrawn' && item.status !== 'closed' && item.status !== 'completed'}}" data-id="{{item.id}}" data-action="edit" catchtap="moreAction">编辑</view><view data-id="{{item.id}}" data-action="preview" catchtap="moreAction">预览</view><view wx:if="{{item.status !== 'draft'}}" data-id="{{item.id}}" data-action="copy" catchtap="moreAction">再次布置</view><view wx:if="{{item.canDeleteDraft}}" class="danger" data-id="{{item.id}}" data-action="deleteDraft" catchtap="moreAction">彻底删除草稿</view><view wx:if="{{item.status !== 'draft'}}" class="danger" data-id="{{item.id}}" data-action="delete" catchtap="moreAction">回收任务</view></block></view>
        </view>
        <view class="task-card-foot"><view><text wx:if="{{item.completedCount !== null}}"><text class="count">{{item.progressPercent}}</text>% 已完成</text><text wx:else>完成情况待核对</text><view class="progress"><view style="width: {{item.progressPercent}}%"></view></view></view><view class="pending"><text>{{item.kind === 'checkin' ? '休息日' : '待点评'}}</text><text>{{item.kind === 'checkin' ? item.restDayCount : item.pendingReviewCount}}</text></view></view>
      </view>
      <view wx:if="{{!rows.length}}" class="empty">暂无符合条件的任务，可调整筛选条件。</view>
      <button wx:if="{{nextOffset !== null}}" class="load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多</button>
    </view>
    <g0-tab-bar role="teacher" active="tasks"></g0-tab-bar>
    </view>
  </view>
</g0-page-shell>
