<view class="page page--secondary">
  <image class="page-bg" src="/assets/g0/student-public-natural-background-v1.jpg" mode="scaleToFill" aria-hidden="true"></image>
  <app-header title="任务详情" back="{{true}}"></app-header>
  <state-panel wx:if="{{loading}}" state="loading"></state-panel>
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" bind:retry="loadDetail"></state-panel>
  <view wx:elif="{{teacherPreviewMode && (teacherPreviewQuestion || teacherPreviewRecording || teacherPreviewAsset)}}" class="content">
    <view class="hero-card"><view class="hero-copy"><text class="label">教师内容预览 · 学生作业界面</text><text class="title">{{teacherPreviewTitle}}</text></view><view class="task-art"><g0-icon name="task" size="64"></g0-icon></view></view>
    <view wx:if="{{teacherPreviewQuestion}}" class="section"><text class="section-title">习题作答</text><view class="completion-item exercise-question"><text class="exercise-stem">{{teacherPreviewQuestion.stem}}</text><view wx:if="{{teacherPreviewQuestion.options.length}}" class="exercise-choices"><button wx:for="{{teacherPreviewQuestion.options}}" wx:key="*this" class="exercise-choice" disabled="{{true}}">{{item}}</button></view><textarea wx:else class="exercise-response" disabled="{{true}}" placeholder="学生在这里填写答案"></textarea><text class="completion-help">只读预览，不记录作答或显示答案。</text></view></view>
    <view wx:if="{{teacherPreviewRecording}}" class="section"><text class="section-title">课堂录音</text><view class="completion-item"><text class="completion-title">{{teacherPreviewRecording.title}}</text><text class="completion-help">{{teacherPreviewRecording.promptText}}</text><view class="recording-controls"><button disabled="{{true}}">开始录音</button><text>教师预览不使用麦克风，也不创建学生录音。</text></view></view></view>
    <view wx:if="{{teacherPreviewAsset}}" class="section task-media-section"><text class="section-title">{{teacherPreviewAsset.kind === 'listening' ? '听力播放' : '视频播放'}}</text><text class="completion-help">按学生页面查看素材与题目；预览不记录有效播放进度或作答。</text>
      <video wx:if="{{teacherPreviewAsset.kind === 'video'}}" id="teacher-preview-video" class="task-media-video {{teacherPreviewEarMode ? 'task-media-video--hidden' : ''}}" src="{{teacherPreviewAsset.playback.temporaryUrl}}" controls="{{false}}" autoplay="{{false}}" show-center-play-btn="{{false}}" bindtimeupdate="onTeacherPreviewVideoTimeUpdate" bindpause="onTeacherPreviewVideoPause" bindended="onTeacherPreviewVideoPause" binderror="onTeacherPreviewVideoError"></video>
      <text wx:if="{{!teacherPreviewEarMode && teacherPreviewSubtitle}}" class="task-media-subtitle">{{teacherPreviewSubtitle}}</text><view wx:if="{{teacherPreviewEarMode}}" class="task-media-ear"><text>文字已隐藏</text><button bindtap="toggleTeacherPreviewEarMode">退出磨耳朵</button></view>
      <media-player title="任务媒体预览" playing="{{teacherPreviewPlaying}}" progress="{{teacherPreviewProgress}}" currentTime="{{teacherPreviewCurrentLabel}}" duration="{{teacherPreviewDurationLabel}}" speed="{{teacherPreviewSpeed}}×" locked="{{false}}" seekLimit="{{100}}" earMode="{{teacherPreviewEarMode}}" state="{{teacherPreviewError ? 'error' : 'ready'}}" bind:toggle="toggleTeacherPreviewPlayback" bind:speed="chooseTeacherPreviewSpeed" bind:earmode="toggleTeacherPreviewEarMode" bind:seek="seekTeacherPreviewMedia" bind:retry="refreshTeacherPreview"></media-player>
      <text wx:if="{{teacherPreviewError}}" class="write-error">{{teacherPreviewError}}</text><button class="open-reading" bindtap="refreshTeacherPreview">刷新预览地址</button>
      <view wx:if="{{!teacherPreviewEarMode && teacherPreviewAsset.questions.length}}" class="task-media-questions"><view wx:for="{{teacherPreviewAsset.questions}}" wx:for-item="question" wx:key="questionId" class="completion-item"><text class="completion-title">{{index + 1}}. {{question.stem}}</text><button wx:if="{{teacherPreviewAsset.kind === 'listening'}}" class="open-reading" data-question-id="{{question.questionId}}" bindtap="playTeacherPreviewClip">播放本题片段</button><view wx:if="{{question.options.length}}" class="exercise-choices"><button wx:for="{{question.options}}" wx:for-item="choice" wx:key="*this" class="exercise-choice" disabled="{{true}}">{{choice}}</button></view><textarea wx:else class="exercise-response" disabled="{{true}}" placeholder="学生在这里填写答案"></textarea></view></view>
    </view>
  </view>
  <view wx:elif="{{teacherReviewMode && teacherReviewItem}}" class="content">
    <view class="hero-card"><view class="hero-copy"><text class="label">教师只读查看 · 第 {{teacherReviewVersion}} 次提交</text><text class="title">{{teacherReviewItem.title}}</text></view><view class="task-art"><g0-icon name="task" size="64"></g0-icon></view></view>
    <view class="section"><text class="section-title">{{teacherReviewItem.type === 'exercise' ? '习题作答' : teacherReviewItem.type === 'recording' ? '课堂录音' : teacherReviewItem.type === 'listening' ? '听力作答' : '视频作答'}}</text>
      <view wx:if="{{teacherMediaEvidence}}" class="task-media-section">
        <text class="completion-help">{{teacherMediaProgress}}。本页只读试听不会写入学生播放进度。</text>
        <video wx:if="{{teacherMediaEvidence.kind === 'video' && teacherMediaEvidence.sourcePlayback.available && teacherMediaEvidence.sourcePlayback.temporaryUrl}}" id="teacher-media-video" class="task-media-video" src="{{teacherMediaEvidence.sourcePlayback.temporaryUrl}}" controls="{{true}}" binderror="onTeacherMediaVideoError"></video>
        <button wx:if="{{teacherMediaEvidence.kind === 'listening' && teacherMediaEvidence.sourcePlayback.available}}" class="open-reading" bindtap="toggleTeacherMediaSource">{{teacherMediaPlaying ? '停止整段试听' : '试听整段音频'}}</button>
        <text wx:if="{{!teacherMediaEvidence.sourcePlayback.available}}" class="completion-help">原媒体当前不可试听，作答与观看记录仍可核对。</text>
        <text wx:if="{{teacherMediaPlaybackError}}" class="write-error">{{teacherMediaPlaybackError}}</text>
        <button class="open-reading" bindtap="refreshTeacherMediaEvidence">刷新授权试听地址</button>
        <view wx:if="{{teacherMediaEvidence.subtitleCues.length}}" class="task-media-questions"><text class="completion-title">已冻结字幕</text><text wx:for="{{teacherMediaEvidence.subtitleCues}}" wx:key="startMs" class="completion-help">{{item.text}}</text></view>
        <view wx:if="{{teacherMediaQuestions.length}}" class="task-media-questions"><view wx:for="{{teacherMediaQuestions}}" wx:for-item="question" wx:key="questionId" class="completion-item"><text class="completion-title">{{index + 1}}. {{question.stem}}</text><button wx:if="{{teacherMediaEvidence.kind === 'listening' && question.clip}}" class="open-reading" data-question-id="{{question.questionId}}" bindtap="playTeacherMediaClip">试听本题片段 {{question.clipLabel}}</button><view wx:if="{{question.options.length}}" class="exercise-choices"><button wx:for="{{question.options}}" wx:for-item="choice" wx:key="value" class="exercise-choice {{choice.selected && question.verdict === '错误' ? 'teacher-wrong' : ''}} {{choice.selected && question.verdict === '正确' ? 'teacher-correct' : ''}}" disabled="{{true}}">{{choice.value}}</button></view><text class="submitted-answer">学生答案：{{question.responseLabel}}</text><text class="completion-help">正确答案：{{question.correctLabel}}</text><text class="teacher-review-verdict">{{question.verdict}}</text><text wx:if="{{question.explanation}}" class="completion-help">解析：{{question.explanation}}</text></view></view>
      </view>
      <view wx:elif="{{teacherReviewItem.type === 'exercise'}}" class="completion-item"><view wx:if="{{teacherExercise}}" class="exercise-question"><text class="exercise-stem">{{teacherExercise.stem}}</text><view wx:if="{{teacherExerciseChoices.length}}" class="exercise-choices"><button wx:for="{{teacherExerciseChoices}}" wx:key="id" class="exercise-choice {{item.selected ? 'selected' : ''}} {{item.selected && teacherExercise.isCorrect === false ? 'teacher-wrong' : ''}} {{item.selected && teacherExercise.isCorrect === true ? 'teacher-correct' : ''}}" disabled="{{true}}">{{item.value}}</button></view><textarea wx:else class="exercise-response" value="{{teacherAnswerLabel}}" disabled="{{true}}"></textarea><text class="submitted-answer">学生答案：{{teacherAnswerLabel}}</text><text class="completion-help">正确答案：{{teacherCorrectLabel}}</text><text class="teacher-review-verdict {{teacherExercise.isCorrect === true ? 'teacher-review-verdict--correct' : teacherExercise.isCorrect === false ? 'teacher-review-verdict--wrong' : ''}}">{{teacherVerdict}}</text><text class="completion-help">解析：{{teacherExercise.explanation}}</text></view><text wx:else class="completion-help">本次提交缺少逐题证据，无法还原原作答。</text></view>
      <view wx:else class="completion-item"><text class="completion-title">{{teacherReviewItem.title}}</text><text class="completion-help">{{teacherReviewItem.recordingPrompt || '按教师要求录制并提交'}}</text><text wx:if="{{teacherRecordingId}}" class="completion-help">录音时长 {{teacherRecordingDuration}}</text><view class="recording-controls"><button wx:if="{{teacherRecordingState === 'available'}}" bindtap="playTeacherRecording">试听学生录音</button><text wx:elif="{{teacherRecordingState === 'expired'}}">录音已过保留期；提交和评分记录仍保留。</text><text wx:elif="{{teacherRecordingState === 'error'}}">录音状态暂不可用，请稍后重试。</text><text wx:else>本次提交没有可试听录音。</text></view></view>
      <view wx:if="{{teacherManualScoreRequired}}" class="teacher-review-score"><text class="teacher-review-score-title">本项评分草稿</text><view class="teacher-review-score-control"><input type="number" maxlength="3" value="{{teacherScoreInput}}" bindinput="onTeacherReviewScore" placeholder="0—100"/><text>分</text></view><text wx:if="{{teacherScoreError}}" class="teacher-review-score-error">{{teacherScoreError}}</text><text class="completion-help">返回教师点评后核对加权总分；发布前仍可修改。</text></view>
    </view>
  </view>
  <view wx:elif="{{detail}}" class="content">
    <view class="hero-card">
      <view class="hero-copy"><text class="label">课堂任务</text><text class="title">{{detail.task.title}}</text><text class="due">截止时间：{{dueLabel}}</text></view>
      <view class="task-art"><g0-icon name="task" size="64"></g0-icon></view>
      <view class="progress" role="progressbar" aria-valuenow="{{progressPercent}}"><view style="width: {{progressPercent}}%;"></view></view>
      <view class="status-row"><view class="status-dot"></view><text class="status">{{statusLabel}} · {{completedCount}}/{{requirementCount}} 项</text><text class="percent">{{progressPercent}}%</text></view>
    </view>
    <view wx:if="{{detail.assignment.status === 'redo_required' || (detail.assignment.status === 'in_progress' && detail.assignment.redoDueAt)}}" class="redo-banner"><text>{{redoExpired ? '重做期限已过' : '退回重做'}}</text><text wx:if="{{redoDueLabel}}">重做截止：{{redoDueLabel}}</text><text wx:else>重做期限不可用，请联系老师</text><text wx:if="{{!redoExpired}}">请重新完成任务要求；上一版作答不会自动沿用。</text></view>
    <view wx:if="{{writeTimingLabel && editable}}" class="availability-note">{{writeTimingLabel}}：请在可提交期限内完成并提交。</view>
    <view wx:if="{{!editable && writeUnavailableReason}}" class="availability-note">{{writeUnavailableReason}}</view>
    <view wx:if="{{!taskMediaEarMode}}" class="section">
      <text class="section-title">任务要求</text>
      <text class="description">{{detail.task.description}}</text>
      <view wx:if="{{readingSyncError}}" class="reading-sync-error"><text>{{readingSyncError}}</text><button bindtap="refreshReadingCompletion">重试同步</button></view>
      <view wx:if="{{selectedReadingSyncError}}" class="reading-sync-error"><text>{{selectedReadingSyncError}}</text><button bindtap="refreshTaskReadingProof">重试同步</button></view>
      <view wx:if="{{vocabularySyncError}}" class="reading-sync-error"><text>{{vocabularySyncError}}</text><button bindtap="refreshVocabularyCompletion">重试同步</button></view>
      <view class="requirement-list"><view wx:for="{{requirementItems}}" wx:key="id" id="requirement-item-{{index}}" class="item {{(item.type === 'reading' || item.type === 'vocabulary') && item.resourceId || item.type === 'listening' || item.type === 'video' || item.type === 'dubbing' || item.type === 'exercise' || item.type === 'recording' ? 'item--content-link' : ''}}" data-id="{{item.id}}" bindtap="openTaskContent"><view class="item-mark"></view><view class="item-copy"><text class="item-title">{{item.title}}</text><text class="item-rule">{{item.completionRule}}</text><text wx:if="{{item.readingPageRangeLabel}}" class="item-rule">指定页：{{item.readingPageRangeLabel}}</text><view class="item-footer"><text class="item-status item-status--{{item.progressTone}}">{{item.progressLabel}}</text><text wx:if="{{item.type === 'reading' && item.resourceId}}" class="content-entry">进入阅读 ›</text><text wx:elif="{{item.type === 'vocabulary' && item.resourceId}}" class="content-entry">进入单词练习 ›</text><text wx:elif="{{item.type === 'listening' || item.type === 'video' || item.type === 'dubbing' || item.type === 'exercise' || item.type === 'recording'}}" class="content-entry">{{item.type === 'listening' ? '进入听力练习' : item.type === 'video' ? '进入视频练习' : item.type === 'dubbing' ? '进入任务配音' : item.type === 'exercise' ? '进入习题作答' : '进入课堂录音'}} ›</text></view></view></view></view>
    </view>
    <view wx:if="{{!taskMediaEarMode && detail.feedback}}" class="feedback"><g0-icon name="review" tone="ai" size="54"></g0-icon><view><text class="section-title">{{detail.feedback.decision === 'returned' ? '退回重做' : '教师反馈'}}</text><text wx:if="{{feedbackVersion}}" class="completion-help">第 {{feedbackVersion}} 次提交的反馈</text><text wx:if="{{detail.feedback.score !== null && detail.feedback.score !== undefined}}" class="score">教师评分：{{detail.feedback.score}} 分</text><text wx:else class="completion-help">此历史反馈未记录分数</text><text wx:if="{{detail.feedback.returnReason}}" class="feedback-copy">重做原因：{{detail.feedback.returnReason}}</text><text wx:if="{{detail.feedback.textComment}}" class="feedback-copy">老师评语：{{detail.feedback.textComment}}</text></view></view>
    <view wx:if="{{!taskMediaEarMode && !detail.feedback && detail.submission && detail.submission.status !== 'draft' && detail.automaticScore !== null && detail.automaticScore !== undefined}}" class="section"><text class="section-title">系统参考分</text><text class="score">{{detail.automaticScore}} 分</text><text>等待老师复核与发布正式反馈。</text></view>
    <view wx:if="{{!taskMediaEarMode && hasCompletionForm && editable}}" class="section completion-section">
      <text class="section-title">任务作答</text>
      <text wx:if="{{hasUnsupportedExercise}}" class="completion-help">本任务含尚未开放的习题内容，暂不能提交；已填写的学习记录可保留。</text>
      <view wx:if="{{recordingError}}" class="reading-sync-error"><text>{{recordingError}}</text></view>
      <block wx:for="{{completionInputs}}" wx:key="itemId"><view wx:if="{{(item.type === 'reading' || item.type === 'vocabulary') && !item.resourceId}}" id="answer-item-{{index}}" class="completion-item">
        <text class="completion-title">{{item.title}}</text>
        <text class="completion-help">完成要求：{{item.type === 'recording' ? '提交有效录音，由老师评分' : item.type === 'reading' ? item.requiredCount + ' 页' : item.type === 'vocabulary' ? item.requiredCount + ' 词' : item.requiredCount + ' 题'}}</text>
        <text wx:if="{{item.type === 'reading' && item.pageIds}}" class="completion-help">请在阅读页完成教师指定的 {{item.pageIds.length}} 页{{item.pageRangeLabel}}。提交时会核对逐页记录。</text>
        <text wx:elif="{{item.type === 'reading' && item.resourceId}}" class="completion-help">{{item.readingVerified ? '阅读进度已同步' : '请先打开阅读并保存进度'}}</text>
        <view wx:if="{{item.type === 'reading' && !item.resourceId}}" class="completion-field"><text>完成页数</text><input type="number" value="{{item.completedPageCount}}" data-id="{{item.itemId}}" data-field="completedPageCount" bindinput="onCompletionInput" placeholder="请输入"/></view>
        <block wx:elif="{{item.type === 'vocabulary'}}"><text wx:if="{{item.resourceId}}" class="completion-help">{{item.vocabularyVerified ? '已同步单词练习记录' : '请先完成单词练习'}}</text><view class="completion-field"><text>完成词数</text><input type="number" value="{{item.completedWordCount}}" disabled="{{item.resourceId ? true : false}}" data-id="{{item.itemId}}" data-field="completedWordCount" bindinput="onCompletionInput" placeholder="练习后自动更新"/></view><view class="completion-field"><text>首次正确词数</text><input type="number" value="{{item.correctWordCount}}" disabled="{{item.resourceId ? true : false}}" data-id="{{item.itemId}}" data-field="correctWordCount" bindinput="onCompletionInput" placeholder="练习后自动更新"/></view></block>
        <block wx:elif="{{item.type === 'recording'}}"><text class="completion-help">{{item.recordingPrompt}}</text><text wx:if="{{item.recordingId}}" class="completion-help">录音已封存，可提交任务。</text><text wx:elif="{{item.recordingState === 'invalid'}}" class="completion-help">本次录音不可提交，请重新录制。</text><text wx:elif="{{item.localRecordingPath}}" class="completion-help">录音已保留在本机，试听后上传。</text><text wx:else class="completion-help">请按提示录制 1 秒至 5 分钟的录音。</text><view class="recording-controls"><button wx:if="{{item.recordingState === 'recording'}}" class="recording-active" bindtap="stopRecording">● 录音中 {{item.recordingElapsedLabel}} · 点击结束</button><button wx:elif="{{item.recordingState === 'idle'}}" data-id="{{item.itemId}}" bindtap="startRecording">开始录音</button><button wx:if="{{item.localRecordingPath && item.recordingState !== 'invalid'}}" data-id="{{item.itemId}}" bindtap="playLocalRecording">试听本机录音</button><button wx:if="{{item.recordingId}}" data-id="{{item.itemId}}" bindtap="playSubmittedRecording">试听已上传录音</button><button wx:if="{{item.recordingState === 'local'}}" data-id="{{item.itemId}}" bindtap="uploadRecording">上传录音</button><button wx:if="{{item.recordingState === 'local' || item.recordingState === 'invalid' || item.recordingState === 'submitted'}}" data-id="{{item.itemId}}" bindtap="redoRecording">重录</button><text wx:if="{{item.recordingState === 'uploading'}}">上传核验中…</text><text wx:if="{{item.recordingState === 'local' || item.recordingState === 'invalid' || item.recordingState === 'submitted'}}">录音时长 {{item.recordingElapsedLabel}}</text></view></block>
        <block wx:else><view wx:if="{{item.exerciseQuestion}}" class="exercise-question"><text class="exercise-stem">{{item.exerciseQuestion.stem}}</text><view wx:if="{{item.exerciseChoices.length}}" class="exercise-choices"><button wx:for="{{item.exerciseChoices}}" wx:for-item="choice" wx:key="value" class="exercise-choice {{choice.selected ? 'selected' : ''}}" data-id="{{item.itemId}}" data-value="{{choice.value}}" bindtap="chooseExerciseOption">{{choice.value}}</button></view><textarea wx:else class="exercise-response" value="{{item.exerciseResponse}}" data-id="{{item.itemId}}" bindinput="onExerciseResponse" placeholder="请输入本题答案" maxlength="500"></textarea></view><view wx:else class="completion-field"><text>{{item.resourceId ? '习题资源暂不可作答' : '已答题数'}}</text><input wx:if="{{!item.resourceId}}" type="number" value="{{item.answeredQuestionCount}}" data-id="{{item.itemId}}" data-field="answeredQuestionCount" bindinput="onCompletionInput" placeholder="请输入"/></view></block>
      </view></block>
    </view>
    <view wx:if="{{!taskMediaEarMode && editable}}" class="section"><text class="section-title">学习记录（选填）</text><textarea value="{{answer}}" maxlength="200" placeholder="可以写下学习收获" bindinput="onAnswer"></textarea></view>
    <view wx:if="{{writeError}}" class="write-error">{{writeError}}</view>
    <view wx:if="{{editable}}" class="completion-help">保存草稿会保留已填写的项目和学习记录；未上传的本机录音需先上传，阅读与单词进度由学习页面单独保存。</view>
    <view wx:if="{{editable}}" class="actions"><view class="task-action secondary" bindtap="onSave" aria-role="button">{{saving ? '保存中…' : '保存草稿'}}</view><view class="task-action {{hasUnsupportedExercise ? 'task-action--disabled' : 'primary'}}" bindtap="onSubmit" aria-role="button">{{hasUnsupportedExercise ? '暂不可提交' : submitting ? '提交中…' : '提交任务'}}</view></view>
  </view>
</view>
