# Copy to a local .env.local only after the user confirms the target development environment.
# Never commit the real values. No login or deployment is performed by this template.
TCB_ENV_ID=
TCB_REGION=ap-shanghai
TCB_AUTH_CLIENT_ID=
YAREI_SCHEMA_VERSION=1
YAREI_SEED_VERSION=m1-dev-example-v1

# Cloud-function runtime secrets. Generate six independent random 32-byte values,
# encode each as 43-character unpadded base64url, and inject them through protected
# CloudBase function configuration. Never commit or print the real values.
YAREI_SUBJECT_PEPPER=
YAREI_QUERY_CURSOR_SIGNING_KEY=
YAREI_BATCH_REVIEW_SIGNING_KEY=
YAREI_BUSINESS_SESSION_ENCRYPTION_KEY=
YAREI_BINDING_CODE_DERIVATION_KEY=
YAREI_BINDING_CODE_PEPPER=
